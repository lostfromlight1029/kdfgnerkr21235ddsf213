            end

            local function start_gelidus_boost()
                if cheat_client.feature_connections.gelidus_boost then return end

                gelidus_active = {}

                if plr.Character then
                    setup_gelidus_character(plr.Character)
                end

                cheat_client.feature_connections.gelidus_boost_character_added = utility:Connection(plr.CharacterAdded, function(character)
                    setup_gelidus_character(character)
                end)

                cheat_client.feature_connections.gelidus_boost = utility:Connection(rs.Heartbeat, LPH_NO_VIRTUALIZE(function()
                    for obj in pairs(gelidus_active) do
                        if not obj.Parent then
                            gelidus_active[obj] = nil
                            continue
                        end

                        if obj.MaxForce ~= GELIDUS_REQUIRED_MAXFORCE then
                            continue
                        end

                        local velocity = obj.Velocity
                        local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
                        local speed = horizontal.Magnitude

                        if speed <= 0 then
                            continue
                        end

                        local direction = horizontal.Unit
                        local gelidus_speed = tonumber(cheat_client.config.gelidus_boost_value) or GELIDUS_DEFAULT_SPEED
                        gelidus_speed = math.clamp(gelidus_speed, 90, 400)

                        if speed >= GELIDUS_MIN_SPEED and speed <= GELIDUS_MAX_SPEED then
                            speed = gelidus_speed
                        end

                        if speed > gelidus_speed then
                            speed = gelidus_speed
                        end

                        obj.Velocity = Vector3.new(
                            direction.X * speed,
                            velocity.Y,
                            direction.Z * speed
                        )
                    end
                end))
            end

