                        new_pants = pants:Clone()
                        new_pants.Parent = character

                        char_custom_enabled.pants = true
                    end

                    char_custom_enabled.clothing_dye = false
                end)

                if not success then print("Error applying outfit: " .. tostring(err)) end
            end

