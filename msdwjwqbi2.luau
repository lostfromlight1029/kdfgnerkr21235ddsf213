        states[profile.name] = {

            --------------------------------------------------
            -- NORMAL PENDING ACTIVATION
            --------------------------------------------------

            pending_at = nil,
            pending_button = nil,
            pending_token = 0,

            --------------------------------------------------
            -- VISUAL
            --------------------------------------------------

            overlay = nil,
            tween = nil,

            -- UI-independent timing cache.  The native cooldown visual can disappear
            -- when a move only lives in one of our extended slots, so keep the confirmed
            -- cooldown window here as the source of truth for extension mirroring.
            cooldown_duration = 0,
            cooldown_end_at = 0,

            --------------------------------------------------
            -- SPECIAL MOVE STATE
            --------------------------------------------------

            special_active = false,
            special_started_at = nil,
            special_button = nil,
            special_token = 0,

            --------------------------------------------------
            -- RIFT DIVE
            --------------------------------------------------

            speedlock_seen = false,
            speedlock_baseline = nil,

            emerge_connections = {},
            emerge_watched =
                setmetatable({}, {
                    __mode = "k"
                }),

            pending_speedlock_seen = false,
            pending_speedlock_baseline = nil,

            --------------------------------------------------
            -- INSTANCE + ANIMATION
            --------------------------------------------------

            pending_required_instance_seen = false,
            pending_required_instance_2_seen = false,
            pending_animation_seen = false,

            --------------------------------------------------
            -- PASSIVE INSTANCE + ANIMATION
            --------------------------------------------------

            passive_signal_started_at = nil,
            passive_animation_seen = false,
            passive_instance_seen = false,
            passive_lock_until = 0,

            --------------------------------------------------
            -- GREAT CYCLONE
            --------------------------------------------------

            great_cyclone_sound = nil,
            great_cyclone_sound_played = false,
            great_cyclone_sound_connections = {},

            --------------------------------------------------
            -- WING SOAR
            --------------------------------------------------

            wing_soar_connection = nil,
            wing_soar_candidates = nil,
            wing_soar_recasts = 0,

            --------------------------------------------------
            -- SPECIAL ANIMATION LOCK
            --------------------------------------------------

            move_in_progress = false,
            move_track_token = 0,
        }
    end

    --------------------------------------------------
    -- ANIMATION ID CLEANER
    --------------------------------------------------

    local function clean_animation_id(animation_id)
        return tostring(animation_id):match("%d+") or ""
    end

    --------------------------------------------------
    -- FIND HOTBAR BUTTON
    --------------------------------------------------

    local function find_hotbar_button(move_name)

        local main_frame = get_backpack_mainframe()

        if not main_frame then
            return nil
        end

        for _, object in ipairs(main_frame:GetChildren()) do

            local displayed_move_name =
                object.Name:match("^%d+(.+)$")

            if displayed_move_name == move_name then
                return object
            end

        end

        return nil
    end

    --------------------------------------------------
    -- GET EQUIPPED REGISTERED MOVE
    --------------------------------------------------

    local function get_equipped_profile()

        local character = plr.Character

        if not character then
            return nil
        end

        for _, object in ipairs(character:GetChildren()) do

            if object:IsA("Tool") then

                local profile =
                    profiles[object.Name]

                if profile then
                    return profile
                end

            end

        end

        return nil
    end

    --------------------------------------------------
    -- SNAP SYSTEM
    --------------------------------------------------

    local snap_system = (function()

        local snap_profiles = {

            --------------------------------------------------
            -- GELIDUS
            --------------------------------------------------

            Gelidus = {

                name = "Gelidus",

                special = "gelidus_remove",

                shared_cooldown = 3.3,

                trigger_instance = "GeliFreezing",
            },

            --------------------------------------------------
            -- GATE
            --------------------------------------------------

            Gate = {

                name = "Gate",

                special = "gate_nofall",

                active_cast_instance = "ActiveCast",

                nofall_instance = "NoFall",

                gate_timer = 8.4,

                nofall_cooldown = 7.15,
            },

            --------------------------------------------------
            -- SNARVINDUR
            --
            -- Blue/shared Snap cooldown. RightClick arms the
            -- detector, then animation 2818022247 must play
            -- within 0.350s.
            --------------------------------------------------

            Snarvindur = {

                name = "Snarvindur",

                special = "animation",

                animation_id = "2818022247",
                animation_window = 0.350,

                shared_cooldown = 8.85,
            },
        }

        local SNAP_OVERLAY_NAME =
            "SnapCooldownVisualizerOverlay"

        local SNAP_COLOR =
            Color3.fromRGB(116, 143, 250)

        local SNAP_TRANSPARENCY = 0.60

        --------------------------------------------------
        -- SNAP STATE
        --------------------------------------------------

        local snap_state = {

            pending_name = nil,
            pending_at = nil,
            pending_token = 0,

            baseline = nil,

            geli_instance = nil,
            geli_connection = nil,

            gate_activecast_seen = false,
            gate_activecast_at = nil,

            gate_activecast_instance = nil,
            gate_activecast_connection = nil,

            gate_nofall_seen = false,
            gate_nofall_seen_at = nil,

            shared_token = 0,

            shared_end_at = 0,
            shared_duration = 0,

            shared_overlays =
                setmetatable({}, {
                    __mode = "k"
                }),

            shared_tweens =
                setmetatable({}, {
                    __mode = "k"
                }),
        }

        --------------------------------------------------
        -- GELIDUS CONNECTION CLEANUP
        --------------------------------------------------

        local function disconnect_geli_connection()

            if snap_state.geli_connection then

                pcall(function()
                    snap_state.geli_connection:Disconnect()
                end)

                snap_state.geli_connection = nil
            end

            snap_state.geli_instance = nil
        end

        --------------------------------------------------
        -- GATE CONNECTION CLEANUP
        --------------------------------------------------

        local function disconnect_gate_activecast_connection()

            if snap_state.gate_activecast_connection then

                pcall(function()
                    snap_state.gate_activecast_connection:Disconnect()
                end)

                snap_state.gate_activecast_connection = nil
            end

            snap_state.gate_activecast_instance = nil
        end

        --------------------------------------------------
        -- CLEAR PENDING SNAP
        --------------------------------------------------

        local function clear_pending()

            disconnect_geli_connection()
            disconnect_gate_activecast_connection()

            snap_state.pending_token += 1

            snap_state.pending_name = nil
            snap_state.pending_at = nil

            snap_state.baseline = nil

            snap_state.gate_activecast_seen = false
            snap_state.gate_activecast_at = nil

            snap_state.gate_activecast_instance = nil

            snap_state.gate_nofall_seen = false
            snap_state.gate_nofall_seen_at = nil
        end

        --------------------------------------------------
        -- DESTROY SHARED VISUALS
        --------------------------------------------------

        local function destroy_shared_visuals()

            for button, tween
                in pairs(snap_state.shared_tweens)
            do

                if tween then
                    pcall(function()
                        tween:Cancel()
                    end)
                end

                snap_state.shared_tweens[button] = nil
            end

            for button, overlay
                in pairs(snap_state.shared_overlays)
            do

                if overlay then
                    pcall(function()
                        overlay:Destroy()
                    end)
                end

                snap_state.shared_overlays[button] = nil
            end

            local main_frame =
                get_backpack_mainframe()

            if main_frame then

                for _, object
                    in ipairs(main_frame:GetChildren())
                do

                    local overlay =
                        FindFirstChild(
                            object,
                            SNAP_OVERLAY_NAME
                        )

                    if overlay then
                        overlay:Destroy()
                    end

                end

            end
        end

        --------------------------------------------------
        -- CREATE BLUE SNAP OVERLAY
        --------------------------------------------------

        local function create_shared_overlay(
            button,
            total_duration,
            remaining,
            token
        )

            if not button
                or not button.Parent
                or remaining <= 0
                or total_duration <= 0
            then
                return
            end

            local existing =
                FindFirstChild(
                    button,
                    SNAP_OVERLAY_NAME
                )

            if existing then
                return
            end

            local ratio =
                math.clamp(
                    remaining / total_duration,
                    0,
                    1
                )

            local overlay =
                Instance.new("Frame")

            overlay.Name =
                SNAP_OVERLAY_NAME

            overlay.AnchorPoint =
                Vector2.new(0, 1)

            overlay.Position =
                UDim2.fromScale(0, 1)

            overlay.Size =
                UDim2.fromScale(
                    1,
                    ratio
                )

            overlay.BackgroundColor3 =
                SNAP_COLOR

            overlay.BackgroundTransparency =
                SNAP_TRANSPARENCY

            overlay.BorderSizePixel = 0

            overlay.ZIndex =
                button.ZIndex + 10

            overlay.Parent =
                button

            local tween =
                TweenService:Create(
                    overlay,

                    TweenInfo.new(
                        remaining,
                        Enum.EasingStyle.Linear,
                        Enum.EasingDirection.Out
                    ),

                    {
                        Size =
                            UDim2.fromScale(
                                1,
                                0
                            )
                    }
                )

            snap_state.shared_overlays[button] =
                overlay

            snap_state.shared_tweens[button] =
                tween

            tween:Play()

            tween.Completed:Connect(function()

                if snap_state.shared_token ~= token then
                    return
                end

                if snap_state.shared_tweens[button] == tween then
                    snap_state.shared_tweens[button] = nil
                end

                if snap_state.shared_overlays[button] == overlay then
                    snap_state.shared_overlays[button] = nil
                end

                if overlay and overlay.Parent then
                    overlay:Destroy()
                end

            end)
        end

        --------------------------------------------------
        -- REFRESH BLUE OVERLAYS
        --------------------------------------------------

        local function refresh_shared_visuals(token)

            if snap_state.shared_token ~= token then
                return false
            end

            local remaining =
                snap_state.shared_end_at - os.clock()

            if remaining <= 0 then
                return false
            end

            local main_frame =
                get_backpack_mainframe()

            if main_frame then

                for _, button
                    in ipairs(main_frame:GetChildren())
                do

                    local snap_name =
                        button.Name:match("^%d+(.+)$")

                    if snap_name
                        and snap_profiles[snap_name]
                        and not FindFirstChild(
                            button,
                            SNAP_OVERLAY_NAME
                        )
                    then

                        create_shared_overlay(
                            button,
                            snap_state.shared_duration,
                            remaining,
                            token
                        )

                    end

                end

            end

            return true
        end

        --------------------------------------------------
        -- START SHARED SNAP COOLDOWN
        --------------------------------------------------

        local function start_shared_cooldown(duration)

            if not ENABLED then
                return
            end

            duration =
                tonumber(duration) or 0

            if duration <= 0 then
                return
            end

            destroy_shared_visuals()

            snap_state.shared_token += 1

            local token =
                snap_state.shared_token

            snap_state.shared_duration =
                duration

            snap_state.shared_end_at =
                os.clock() + duration

            refresh_shared_visuals(token)

            task.spawn(function()

                while ENABLED
                    and snap_state.shared_token == token
                    and snap_state.shared_end_at > os.clock()
                do

                    refresh_shared_visuals(token)

                    task.wait(0.1)
                end

                if snap_state.shared_token == token then

                    snap_state.shared_end_at = 0
                    snap_state.shared_duration = 0

                    destroy_shared_visuals()
                end

            end)
        end

        --------------------------------------------------
        -- SNAPSHOT INSTANCES
        --------------------------------------------------

        local function snapshot_instances(
            character,
            wanted_names
        )

            local baseline =
                setmetatable({}, {
                    __mode = "k"
                })

            if not character then
                return baseline
            end

            for _, object
                in ipairs(character:GetDescendants())
            do

                if wanted_names[object.Name] then
                    baseline[object] = true
                end

            end

            return baseline
        end

        --------------------------------------------------
        -- FINISH SNAP
        --------------------------------------------------

        local function finish_pending_with_shared_cooldown(
            token,
            duration
        )

            if snap_state.pending_token ~= token then
                return
            end

            clear_pending()

            start_shared_cooldown(duration)
        end

        --------------------------------------------------
        -- GELIDUS FREEZING WATCH
        --------------------------------------------------

        local function watch_geli_freezing(
            profile,
            object,
            token
        )

            if snap_state.pending_token ~= token
                or snap_state.pending_name ~= profile.name
                or not object
                or object.Name ~= profile.trigger_instance
            then
                return
            end

            disconnect_geli_connection()

            snap_state.geli_instance =
                object

            local character =
                plr.Character

            local connection

            connection =
                object.AncestryChanged:Connect(function()

                    task.defer(function()

                        if snap_state.pending_token ~= token
                            or snap_state.pending_name ~= profile.name
                        then

                            if connection then
                                connection:Disconnect()
                                connection = nil
                            end

                            return
                        end

                        local current_character =
                            plr.Character

                        if not object.Parent
                            or not current_character
                            or not object:IsDescendantOf(
                                current_character
                            )
                        then

                            if connection then
                                connection:Disconnect()
                                connection = nil
                            end

                            snap_state.geli_connection = nil
                            snap_state.geli_instance = nil

                            finish_pending_with_shared_cooldown(
                                token,
                                profile.shared_cooldown
                            )

                        end

                    end)

                end)

            snap_state.geli_connection =
                connection

            task.defer(function()

                if snap_state.pending_token == token
                    and snap_state.pending_name == profile.name
                    and (
                        not object.Parent
                        or not character
                        or not object:IsDescendantOf(character)
                    )
                then

                    finish_pending_with_shared_cooldown(
                        token,
                        profile.shared_cooldown
                    )

                end

            end)
        end

        --------------------------------------------------
        -- GATE SUCCESS
        --------------------------------------------------

        local function resolve_gate_success(
            profile,
            token
        )

            finish_pending_with_shared_cooldown(
                token,
                profile.nofall_cooldown
            )
        end

        --------------------------------------------------
        -- GATE ACTIVECAST WINDOW
        --------------------------------------------------

        local function begin_gate_nofall_window(
            profile,
            active_cast,
            token
        )

            if snap_state.pending_token ~= token
                or snap_state.pending_name ~= profile.name
                or snap_state.gate_activecast_seen
                or not active_cast
            then
                return
            end

            snap_state.gate_activecast_seen =
                true

            snap_state.gate_activecast_at =
                os.clock()

            snap_state.gate_activecast_instance =
                active_cast

            local connection

            connection =
                active_cast.AncestryChanged:Connect(function()

                    task.defer(function()

                        if snap_state.pending_token ~= token
                            or snap_state.pending_name ~= profile.name
                        then

                            if connection then
                                connection:Disconnect()
                                connection = nil
                            end

                            return
                        end

                        local character =
                            plr.Character

                        local removed =
                            not active_cast.Parent
                            or not character
                            or not active_cast:IsDescendantOf(
                                character
                            )

                        if removed
                            and not snap_state.gate_nofall_seen
                        then

                            if connection then
                                connection:Disconnect()
                                connection = nil
                            end

                            snap_state.gate_activecast_connection =
                                nil

                            snap_state.gate_activecast_instance =
                                nil

                            local timer =
                                profile.gate_timer
                                or 8.4

                            local elapsed =
                                math.max(
                                    0,
                                    os.clock()
                                    - snap_state.gate_activecast_at
                                )

                            local remaining =
                                math.max(
                                    0,
                                    timer - elapsed
                                )

                            if remaining > 0 then

                                finish_pending_with_shared_cooldown(
                                    token,
                                    remaining
                                )

                            else

                                clear_pending()

                            end

                        end

                    end)

                end)

            snap_state.gate_activecast_connection =
                connection

            local window =
                profile.gate_timer or 8.4

            task.delay(
                window,

                function()

                    if snap_state.pending_token ~= token
                        or snap_state.pending_name ~= profile.name
                        or not snap_state.gate_activecast_seen
                    then
                        return
                    end

                    clear_pending()

                end
            )
        end

        --------------------------------------------------
        -- SNAP CHARACTER SIGNAL
        --------------------------------------------------

        local function handle_descendant_added(object)

            if not ENABLED
                or not object
                or not snap_state.pending_name
                or not snap_state.pending_at
            then
                return
            end

            local profile =
                snap_profiles[
                    snap_state.pending_name
                ]

            if not profile then
                return
            end

            local token =
                snap_state.pending_token

            local baseline =
                snap_state.baseline

            if baseline
                and baseline[object]
            then
                return
            end

            --------------------------------------------------
            -- GELIDUS
            --------------------------------------------------

            if profile.special == "gelidus_remove" then

                if object.Name == profile.trigger_instance then

                    watch_geli_freezing(
                        profile,
                        object,
                        token
                    )

                end

            --------------------------------------------------
            -- GATE
            --------------------------------------------------

            elseif profile.special == "gate_nofall" then

                if object.Name == profile.active_cast_instance then

                    begin_gate_nofall_window(
                        profile,
                        object,
                        token
                    )

                elseif object.Name == profile.nofall_instance
                    and snap_state.gate_activecast_seen
                    and snap_state.gate_activecast_at
                then

                    snap_state.gate_nofall_seen =
                        true

                    snap_state.gate_nofall_seen_at =
                        os.clock()

                    if (
                        snap_state.gate_nofall_seen_at
                        - snap_state.gate_activecast_at
                    ) <= (
                        profile.gate_timer or 8.4
                    )
                    then

                        resolve_gate_success(
                            profile,
                            token
                        )

                    end

                end

            end
        end

        --------------------------------------------------
        -- SNAP ANIMATION SIGNAL
        --------------------------------------------------

        local function handle_animation(animation_id)

            if not ENABLED
                or not snap_state.pending_name
                or not snap_state.pending_at
            then
                return
            end

            local profile =
                snap_profiles[
                    snap_state.pending_name
                ]

            if not profile
                or profile.special ~= "animation"
            then
                return
            end

            if tostring(animation_id) ~= tostring(profile.animation_id) then
                return
            end

            local elapsed =
                os.clock() - snap_state.pending_at

            local window =
                profile.animation_window or 0.350

            if elapsed < 0
                or elapsed > window
            then
                return
            end

            finish_pending_with_shared_cooldown(
                snap_state.pending_token,
                profile.shared_cooldown or 6.0
            )
        end

        --------------------------------------------------
        -- EQUIPPED SNAP
        --------------------------------------------------

        local function get_equipped_snap_profile()

            local character =
                plr.Character

            if not character then
                return nil
            end

            for _, object
                in ipairs(character:GetChildren())
            do

                if object:IsA("Tool") then

                    local profile =
                        snap_profiles[object.Name]

                    if profile then
                        return profile
                    end

                end

            end

            return nil
        end

        --------------------------------------------------
        -- RIGHTCLICK
        --------------------------------------------------

        local function handle_remote(
            event,
            remotes_folder
        )

            if not ENABLED then
                return
            end

            if not remotes_folder
                or event.Parent ~= remotes_folder
                or event.Name ~= "RightClick"
            then
                return
            end

            local profile =
                get_equipped_snap_profile()

            clear_pending()

            if not profile then
                return
            end

            snap_state.pending_name =
                profile.name

            snap_state.pending_at =
                os.clock()

            local wanted_names = {}

            if profile.special == "gelidus_remove" then

                wanted_names[
                    profile.trigger_instance
                ] = true

            elseif profile.special == "gate_nofall" then

                wanted_names[
                    profile.active_cast_instance
                ] = true

                wanted_names[
                    profile.nofall_instance
                ] = true

            end

            snap_state.baseline =
                snapshot_instances(
                    plr.Character,
                    wanted_names
                )
        end

        --------------------------------------------------
        -- RESET SNAP
        --------------------------------------------------

        local function reset_all()

            clear_pending()

            snap_state.shared_token += 1

            snap_state.shared_end_at = 0
            snap_state.shared_duration = 0

            destroy_shared_visuals()
        end

        local function get_active_visual(move_name)
            if not ENABLED or not snap_profiles[move_name] then
                return nil
            end

            local total = tonumber(snap_state.shared_duration) or 0
            local remaining = (tonumber(snap_state.shared_end_at) or 0) - os.clock()

            if total <= 0 or remaining <= 0 then
                return nil
            end

            return {
                duration = total,
                remaining = math.min(remaining, total),
            }
        end

        return {
            handle_remote = handle_remote,
            handle_animation = handle_animation,
            handle_descendant_added =
                handle_descendant_added,
            reset_all = reset_all,
            get_active_visual = get_active_visual,
        }

    end)()

    --------------------------------------------------
    -- CANCEL MOVE VISUAL
    --------------------------------------------------

    local function cancel_visual(profile)

        local state =
            profile
            and states[profile.name]

        if not state then
            return
        end

        if state.tween then

            pcall(function()
                state.tween:Cancel()
            end)

            state.tween = nil
        end

        if state.overlay then

            pcall(function()
                state.overlay:Destroy()
            end)

            state.overlay = nil
        end
    end

    --------------------------------------------------
    -- CLEAR MOVE
    --------------------------------------------------

    local function clear_move(profile)

        local state =
            profile
            and states[profile.name]

        if not state then
            return
        end

        --------------------------------------------------
        -- PENDING
        --------------------------------------------------

        state.pending_at = nil
        state.pending_button = nil

        state.pending_token += 1

        state.pending_speedlock_seen = false
        state.pending_speedlock_baseline = nil

        state.pending_required_instance_seen = false
        state.pending_required_instance_2_seen = false
        state.pending_animation_seen = false

        state.passive_signal_started_at = nil
        state.passive_animation_seen = false
        state.passive_instance_seen = false
        state.passive_lock_until = 0

        --------------------------------------------------
        -- SPECIAL
        --------------------------------------------------

        state.special_active = false
        state.special_started_at = nil
        state.special_button = nil

        state.special_token += 1

        state.speedlock_seen = false
        state.speedlock_baseline = nil

        --------------------------------------------------
        -- GREAT CYCLONE
        --------------------------------------------------

        if state.great_cyclone_sound_connections then

            for _, connection in ipairs(state.great_cyclone_sound_connections) do
                pcall(function()
                    connection:Disconnect()
                end)
            end
        end

        state.great_cyclone_sound_connections = {}
        state.great_cyclone_sound = nil
        state.great_cyclone_sound_played = false

        --------------------------------------------------
        -- WING SOAR
        --------------------------------------------------

        if state.wing_soar_connection then
            pcall(function()
                state.wing_soar_connection:Disconnect()
            end)

            state.wing_soar_connection = nil
        end

        state.wing_soar_candidates = nil
        state.wing_soar_recasts = 0

        --------------------------------------------------
        -- EMERGE
        --------------------------------------------------

        if state.emerge_connections then

            for _, connection
                in ipairs(state.emerge_connections)
            do

                pcall(function()
                    connection:Disconnect()
                end)

            end

        end

        state.emerge_connections = {}

        state.emerge_watched =
            setmetatable({}, {
                __mode = "k"
            })

        --------------------------------------------------
        -- TRACK
        --------------------------------------------------

        state.move_track_token += 1
        state.move_in_progress = false

        cancel_visual(profile)

        -- clear_move is the hard reset path (disable/respawn/cleanup), unlike
        -- cancel_visual which is also used when replacing one confirmed cooldown.
        state.cooldown_duration = 0
        state.cooldown_end_at = 0
    end

    --------------------------------------------------
    -- CLEAR ALL
    --------------------------------------------------

    local function clear_all()

        for _, profile
            in pairs(profiles)
        do

            clear_move(profile)

        end
    end

    --------------------------------------------------
    -- REMOVE RED UI OVERLAYS
    --------------------------------------------------

    local function remove_ui_overlays()

        local main_frame =
            get_backpack_mainframe()

        if not main_frame then
            return
        end

        for _, object
            in ipairs(main_frame:GetChildren())
        do

            local overlay =
                FindFirstChild(
                    object,
                    "CooldownVisualizerOverlay"
                )

            if overlay then
                overlay:Destroy()
            end

        end
    end

    --------------------------------------------------
    -- START RED COOLDOWN
    --------------------------------------------------

    local function start_cooldown(
        profile,
        cached_button,
        duration_override,
        elapsed_offset
    )

        if not ENABLED then
            return
        end

        local state =
            states[profile.name]

        if not state then
            return
        end

        --------------------------------------------------
        -- DURATION / UI-INDEPENDENT STATE
        --------------------------------------------------

        local total_duration =
            tonumber(duration_override)
            or profile.cooldown_time

        if total_duration <= 0 then
            return
        end

        local elapsed =
            math.clamp(
                tonumber(elapsed_offset) or 0,
                0,
                total_duration
            )

        local remaining =
            total_duration - elapsed

        --------------------------------------------------
        -- EVERY CONFIRMED USE REPLACES OLD VISUAL
        --------------------------------------------------

        cancel_visual(profile)

        if remaining <= 0 then
            state.cooldown_duration = 0
            state.cooldown_end_at = 0
            return
        end

        -- Keep timing even if Rogue has no native hotbar button for this move.
        -- Extended hotbar cards query this through the public API below.
        state.cooldown_duration = total_duration
        state.cooldown_end_at = os.clock() + remaining

        --------------------------------------------------
        -- FIND NATIVE UI BUTTON (OPTIONAL)
        --------------------------------------------------

        local move_button =
            cached_button

        if not move_button
            or not move_button.Parent
        then

            move_button =
                find_hotbar_button(
                    profile.name
                )

        end

        -- No native card is fine: the cooldown is still live in state and will
        -- render on an assigned extended slot.
        if not move_button then
            return
        end

        local old_overlay =
            FindFirstChild(
                move_button,
                "CooldownVisualizerOverlay"
            )

        if old_overlay then
            old_overlay:Destroy()
        end

        local remaining_ratio =
            remaining / total_duration

        --------------------------------------------------
        -- RED OVERLAY
        --------------------------------------------------

        local overlay =
            Instance.new("Frame")

        overlay.Name =
            "CooldownVisualizerOverlay"

        overlay.AnchorPoint =
            Vector2.new(0, 1)

        overlay.Position =
            UDim2.fromScale(0, 1)

        overlay.Size =
            UDim2.fromScale(
                1,
                remaining_ratio
            )

        overlay.BackgroundColor3 =
            Color3.fromRGB(
                255,
                84,
                81
            )

        overlay.BackgroundTransparency =
            0.60

        overlay.BorderSizePixel =
            0

        overlay.ZIndex =
            move_button.ZIndex + 10

        overlay.Parent =
            move_button

        --------------------------------------------------
        -- TWEEN
        --------------------------------------------------

        local tween =
            TweenService:Create(
                overlay,

                TweenInfo.new(
                    remaining,
                    Enum.EasingStyle.Linear,
                    Enum.EasingDirection.Out
                ),

                {
                    Size =
                        UDim2.fromScale(
                            1,
                            0
                        )
                }
            )

        state.overlay =
            overlay

        state.tween =
            tween

        tween:Play()

        tween.Completed:Connect(function()

            if state.tween ~= tween then
                return
            end

            state.tween = nil
            state.overlay = nil

            if state.cooldown_end_at <= os.clock() then
                state.cooldown_duration = 0
                state.cooldown_end_at = 0
            end

            if overlay
                and overlay.Parent
            then

                overlay:Destroy()

            end

        end)
    end

    --------------------------------------------------
    -- DISCONNECT EMERGE WATCHERS
    --------------------------------------------------

    local function disconnect_emerge_watchers(state)

        if state.emerge_connections then

            for _, connection
                in ipairs(state.emerge_connections)
            do

                pcall(function()
                    connection:Disconnect()
                end)

            end

        end

        state.emerge_connections = {}

        state.emerge_watched =
            setmetatable({}, {
                __mode = "k"
            })
    end

    --------------------------------------------------
    -- RESET SPECIAL STATE
    --------------------------------------------------

    local function reset_special_state(state)

        disconnect_emerge_watchers(state)

        state.special_active = false
        state.special_started_at = nil
        state.special_button = nil

        state.speedlock_seen = false
        state.speedlock_baseline = nil
    end

    --------------------------------------------------
    -- RIFT DIVE EMERGE
    --------------------------------------------------

    local function finish_rift_dive_from_emerge(
        profile,
        state
    )

        if not state.special_active
            or not state.special_started_at
        then
            return
        end

        if not state.speedlock_seen then
            return
        end

        local elapsed =
            os.clock()
            - state.special_started_at

        if elapsed < 0
            or elapsed > (
                profile.emerge_window
                or 10
            )
        then
            return
        end

        local button =
            state.special_button

        local duration =
            profile.emerge_cooldown
            or 30

        state.special_token += 1

        reset_special_state(state)

        --------------------------------------------------
        -- CD BEGINS NOW
        --------------------------------------------------

        start_cooldown(
            profile,
            button,
            duration,
            0
        )
    end

    --------------------------------------------------
    -- WATCH EMERGE SOUND
    --------------------------------------------------

    local function watch_emerge_sound(
        profile,
        state,
        sound
    )

        if not sound
            or not sound:IsA("Sound")
            or sound.Name ~= "Emerge"
        then
            return
        end

        state.emerge_watched =
            state.emerge_watched
            or setmetatable({}, {
                __mode = "k"
            })

        state.emerge_connections =
            state.emerge_connections
            or {}

        if state.emerge_watched[sound] then
            return
        end

        state.emerge_watched[sound] =
            true

        --------------------------------------------------
        -- :PLAY()
        --------------------------------------------------

        local played_connection =
            sound.Played:Connect(function()

                finish_rift_dive_from_emerge(
                    profile,
                    state
                )

            end)

        table.insert(
            state.emerge_connections,
            played_connection
        )

        --------------------------------------------------
        -- PLAYING PROPERTY
        --------------------------------------------------

        local playing_connection =
            sound:GetPropertyChangedSignal(
                "Playing"
            ):Connect(function()

                if sound.Playing then

                    finish_rift_dive_from_emerge(
                        profile,
                        state
                    )

                end

            end)

        table.insert(
            state.emerge_connections,
            playing_connection
        )

        --------------------------------------------------
        -- ALREADY STARTED RACE
        --------------------------------------------------

        if sound.Playing then

            task.defer(function()

                finish_rift_dive_from_emerge(
                    profile,
                    state
                )

            end)

        end
    end

    --------------------------------------------------
    -- SPECIAL ANIMATION TRACK LOCK
    --------------------------------------------------

    local function mark_special_animation_active(
        state,
        track
    )

        state.move_track_token += 1

        local token =
            state.move_track_token

        state.move_in_progress =
            true

        if not track then
            return
        end

        local stop_connection

        stop_connection =
            track.Stopped:Connect(function()

                if state.move_track_token == token then
                    state.move_in_progress = false
                end

                if stop_connection then

                    stop_connection:Disconnect()
                    stop_connection = nil

                end

            end)

        --------------------------------------------------
        -- SAFETY TIMEOUT
        --------------------------------------------------

        task.delay(15, function()

            if state.move_track_token == token then
                state.move_in_progress = false
            end

            if stop_connection then

                pcall(function()
                    stop_connection:Disconnect()
                end)

                stop_connection = nil
            end

        end)
    end

    --------------------------------------------------
    -- RIFT DIVE RESOLUTION
    --------------------------------------------------

    local function start_rift_dive_resolution(
        profile,
        state,
        cached_button,
        activation_at,
        early_speedlock_seen,
        speedlock_baseline
    )

        --------------------------------------------------
        -- NEW USE REPLACES OLD VISUAL
        --------------------------------------------------

        cancel_visual(profile)

        state.special_token += 1

        local token =
            state.special_token

        state.special_active =
            true

        state.special_started_at =
            activation_at

        state.special_button =
            cached_button

        state.speedlock_seen =
            early_speedlock_seen
            and true
            or false

        state.speedlock_baseline =
            speedlock_baseline

        --------------------------------------------------
        -- WATCH EXISTING EMERGE SOUNDS
        --------------------------------------------------

        local character =
            plr.Character

        if character then

            for _, object
                in ipairs(character:GetDescendants())
            do

                if object:IsA("Sound")
                    and object.Name == "Emerge"
                then

                    watch_emerge_sound(
                        profile,
                        state,
                        object
                    )

                end

            end

        end

        local speedlock_window =
            profile.speedlock_window
            or 1.25

        local emerge_window =
            profile.emerge_window
            or 10

        --------------------------------------------------
        -- NO SPEEDLOCK FALLBACK
        --------------------------------------------------

        task.delay(
            math.max(
                0,
                (
                    activation_at
                    + speedlock_window
                )
                - os.clock()
            ),

            function()

                if state.special_token ~= token
                    or not state.special_active
                then
                    return
                end

                --------------------------------------------------
                -- AUTHORITATIVE SPEEDLOCK RESCAN
                --------------------------------------------------

                if not state.speedlock_seen then

                    local current_character =
                        plr.Character

                    local baseline =
                        state.speedlock_baseline

                    if current_character then

                        for _, object
                            in ipairs(
                                current_character:GetDescendants()
                            )
                        do

                            if object.Name == "SpeedLock"
                                and (
                                    not baseline
                                    or not baseline[object]
                                )
                            then

                                state.speedlock_seen =
                                    true

                                break
                            end

                        end

                    end

                end

                --------------------------------------------------
                -- NO SPEEDLOCK
                --------------------------------------------------

                if not state.speedlock_seen then

                    local button =
                        state.special_button

                    local elapsed =
                        math.max(
                            0,
                            os.clock()
                            - activation_at
                        )

                    state.special_token += 1

                    reset_special_state(state)

                    start_cooldown(
                        profile,
                        button,
                        profile.cooldown_time,
                        elapsed
                    )

                end

            end
        )

        --------------------------------------------------
        -- EMERGE NEVER PLAYED FALLBACK
        --------------------------------------------------

        task.delay(
            math.max(
                0,
                (
                    activation_at
                    + emerge_window
                )
                - os.clock()
            ),

            function()

                if state.special_token ~= token
                    or not state.special_active
                then
                    return
                end

                local button =
                    state.special_button

                local elapsed =
                    math.max(
                        0,
                        os.clock()
                        - activation_at
                    )

                state.special_token += 1

                reset_special_state(state)

                start_cooldown(
                    profile,
                    button,
                    profile.cooldown_time,
                    elapsed
                )

            end
        )
    end

    --------------------------------------------------
    -- GREAT CYCLONE HELPERS
    --------------------------------------------------

    local function disconnect_great_cyclone_connections(state)

        if state.great_cyclone_sound_connections then

            for _, connection in ipairs(state.great_cyclone_sound_connections) do
                pcall(function()
                    connection:Disconnect()
                end)
            end
        end

        state.great_cyclone_sound_connections = {}
    end

    local function reset_great_cyclone_state(state)

        disconnect_great_cyclone_connections(state)

        state.special_active = false
        state.special_started_at = nil
        state.special_button = nil

        state.great_cyclone_sound = nil
        state.great_cyclone_sound_played = false
    end

    local function finish_great_cyclone_from_sound(
        profile,
        state,
        sound,
        token
    )

        if state.special_token ~= token
            or not state.special_active
            or state.great_cyclone_sound ~= sound
            or not state.great_cyclone_sound_played
        then
            return
        end

        local button =
            state.special_button


        state.special_token += 1

        reset_great_cyclone_state(state)

        --------------------------------------------------
        -- RELEASESOUND STOPPED PLAYING -> 10.3s COOLDOWN
        --------------------------------------------------

        start_cooldown(
            profile,
            button,
            profile.release_sound_end_cooldown or 10.3
        )
    end

    local function watch_great_cyclone_release_sound(
        profile,
        state,
        sound
    )

        if state.great_cyclone_sound
            or not sound
            or not sound:IsA("Sound")
            or sound.Name ~= (profile.release_sound_name or "ReleaseSound")
        then
            return
        end

        local token =
            state.special_token

        state.great_cyclone_sound = sound
        state.great_cyclone_sound_played = sound.Playing


        local function check_playing()

            if state.special_token ~= token
                or not state.special_active
                or state.great_cyclone_sound ~= sound
            then
                return
            end


            if sound.Playing then
                state.great_cyclone_sound_played = true
                return
            end

            if state.great_cyclone_sound_played then
                finish_great_cyclone_from_sound(
                    profile,
                    state,
                    sound,
                    token
                )
            end
        end

        local playing_connection =
            sound:GetPropertyChangedSignal("Playing"):Connect(
                check_playing
            )

        table.insert(
            state.great_cyclone_sound_connections,
            playing_connection
        )

        local ended_connection =
            sound.Ended:Connect(function()


                if state.special_token ~= token
                    or not state.special_active
                    or state.great_cyclone_sound ~= sound
                then
                    return
                end

                state.great_cyclone_sound_played = true

                finish_great_cyclone_from_sound(
                    profile,
                    state,
                    sound,
                    token
                )
            end)

        table.insert(
            state.great_cyclone_sound_connections,
            ended_connection
        )

        local ancestry_connection =
            sound.AncestryChanged:Connect(function()

                -- Sound.Ended / Playing=false are not guaranteed to fire
                -- when the sound is removed/destroyed. Treat leaving the
                -- current character as the ReleaseSound ending.
                task.defer(function()
                    if state.special_token ~= token
                        or not state.special_active
                        or state.great_cyclone_sound ~= sound
                    then
                        return
                    end

                    local character = plr.Character
                    local removed =
                        not sound.Parent
                        or not character
                        or not sound:IsDescendantOf(character)

                    if not removed then
                        return
                    end

                    if state.great_cyclone_sound_played then

                        finish_great_cyclone_from_sound(
                            profile,
                            state,
                            sound,
                            token
                        )
                    else
                        -- It vanished before we ever observed it playing.
                        -- Release this candidate so the original 2.25s
                        -- timeout can still resolve to the 8.5s cooldown.

                        disconnect_great_cyclone_connections(state)
                        state.great_cyclone_sound = nil
                        state.great_cyclone_sound_played = false
                    end
                end)
            end)

        table.insert(
            state.great_cyclone_sound_connections,
            ancestry_connection
        )

        --------------------------------------------------
        -- CATCH PLAY/STOP RACES IMMEDIATELY AFTER ADDITION
        --------------------------------------------------

        task.defer(check_playing)
    end

    local function start_great_cyclone_resolution(
        profile,
        state,
        cached_button
    )

        state.special_token += 1

        local token =
            state.special_token

        state.special_active = true
        state.special_started_at = os.clock()
        state.special_button = cached_button

        state.great_cyclone_sound = nil
        state.great_cyclone_sound_played = false

        disconnect_great_cyclone_connections(state)

        --------------------------------------------------
        -- AFTER ANIMATION CONFIRMATION, WAIT AT MOST 2.25s
        -- FOR A NEW RELEASESOUND.
        --------------------------------------------------

        local window =
            profile.release_sound_window
            or 2.25


        task.delay(window, function()

            if state.special_token == token
                and state.special_active
                and not state.great_cyclone_sound
            then

                local button =
                    state.special_button


                state.special_token += 1
                reset_great_cyclone_state(state)

                --------------------------------------------------
                -- NO RELEASESOUND WITHIN 2.25s -> 8.5s COOLDOWN
                --------------------------------------------------

                start_cooldown(
                    profile,
                    button,
                    profile.release_sound_timeout_cooldown or 8.5
                )

            end

        end)
    end

    --------------------------------------------------
    -- WING SOAR HELPERS
    --------------------------------------------------

    local function disconnect_wing_soar_connection(state)

        if state.wing_soar_connection then

            pcall(function()
                state.wing_soar_connection:Disconnect()
            end)

            state.wing_soar_connection = nil
        end

        state.wing_soar_candidates = nil
    end

    local function wing_soar_velocity_matches(
        profile,
        body_velocity,
        y_min,
        y_max
    )

        if not body_velocity
            or not body_velocity:IsA("BodyVelocity")
        then
            return false
        end

        local success,
            velocity,
            max_force =
            pcall(function()
                return body_velocity.Velocity,
                    body_velocity.MaxForce
            end)

        if not success
            or not velocity
            or not max_force
        then
            return false
        end

        --------------------------------------------------
        -- SCREENSHOT / LOGGER SIGNATURE:
        -- MaxForce.Y must be effectively infinite.
        --------------------------------------------------

        local required_maxforce_y =
            profile.required_maxforce_y
            or math.huge

        if required_maxforce_y == math.huge then

            if max_force.Y ~= math.huge then
                return false
            end

        elseif max_force.Y < required_maxforce_y then
            return false
        end

        return velocity.Y >= y_min
            and velocity.Y <= y_max
    end

    local function find_wing_soar_candidate(
        profile,
        candidates,
        added_after,
        added_before,
        y_min,
        y_max
    )

        if not candidates then
            return nil
        end

        for object, added_at
            in pairs(candidates)
        do

            if added_at >= added_after
                and added_at <= added_before
                and wing_soar_velocity_matches(
                    profile,
                    object,
                    y_min,
                    y_max
                )
            then
                return object
            end
        end

        return nil
    end

    local function finish_wing_soar_cooldown(
        profile,
        state,
        token,
        duration_override
    )

        if state.special_token ~= token
            or not state.special_active
        then
            return
        end

        local button =
            state.special_button

        state.special_token += 1

        state.special_active = false
        state.special_started_at = nil
        state.special_button = nil

        state.wing_soar_recasts = 0
        state.move_in_progress = false

        disconnect_wing_soar_connection(state)

        start_cooldown(
            profile,
            button,
            duration_override or profile.cooldown_time or 14.5
        )
    end

    local function start_wing_soar_recast_resolution(
        profile,
        state,
        cached_button,
        character
    )

        state.special_token += 1

        local token =
            state.special_token

        state.special_active = true
        state.special_started_at = os.clock()
        state.special_button = cached_button

        state.wing_soar_recasts = 0
        state.move_in_progress = false

        local candidates =
            state.wing_soar_candidates

        local recast_window =
            profile.recast_window
            or 4

        local max_recasts =
            profile.max_recasts
            or 2

        task.spawn(function()

            for recast_index = 1, max_recasts do

                if state.special_token ~= token
                    or not state.special_active
                    or not ENABLED
                    or plr.Character ~= character
                then
                    return
                end

                local window_started_at =
                    os.clock()

                local window_ends_at =
                    window_started_at
                    + recast_window

                local matched_velocity = nil

                --------------------------------------------------
                -- EACH RECAST GETS ITS OWN 4 SECOND WINDOW.
                --------------------------------------------------

                repeat

                    if state.special_token ~= token
                        or not state.special_active
                        or not ENABLED
                        or plr.Character ~= character
                    then
                        return
                    end

                    matched_velocity =
                        find_wing_soar_candidate(
                            profile,
                            candidates,
                            window_started_at,
                            window_ends_at,
                            profile.recast_velocity_y_min or 58,
                            profile.recast_velocity_y_max or 63
                        )

                    if matched_velocity then
                        break
                    end

                    task.wait()

                until os.clock() > window_ends_at

                --------------------------------------------------
                -- NO RECAST IN THIS 4s WINDOW -> CHAIN ENDS.
                -- This also covers using Wing Soar with zero
                -- recasts, or using only the first recast.
                --------------------------------------------------

                if not matched_velocity then

                    finish_wing_soar_cooldown(
                        profile,
                        state,
                        token,
                        profile.incomplete_recast_cooldown or 10.3
                    )

                    return
                end

                candidates[matched_velocity] = nil
                state.wing_soar_recasts = recast_index

                --------------------------------------------------
                -- SECOND RECAST CONFIRMED -> START 14.5s CD NOW.
                -- A timeout in either 4s window uses 10.3s instead.
                --------------------------------------------------

                if recast_index >= max_recasts then

                    finish_wing_soar_cooldown(
                        profile,
                        state,
                        token
                    )

                    return
                end
            end
        end)
    end

    local function start_wing_soar_initial_scan(
        profile,
        state,
        token
    )

        local character =
            plr.Character

        if not character then
            return
        end

        disconnect_wing_soar_connection(state)

        local candidates = {}

        state.wing_soar_candidates =
            candidates

        state.move_in_progress = true

        --------------------------------------------------
        -- IMPORTANT: THIS CONNECTION IS CREATED BEFORE THE
        -- ORIGINAL LEFTCLICK FIRESERVER CALL CONTINUES, SO WE
        -- ONLY CAPTURE BODYVELOCITIES ADDED BY/AFTER THE USE.
        --------------------------------------------------

        state.wing_soar_connection =
            character.DescendantAdded:Connect(function(object)

                if object:IsA("BodyVelocity") then
                    candidates[object] = os.clock()
                end

            end)

        local activation_at =
            state.pending_at
            or os.clock()

        local confirmation_window =
            profile.confirmation_window
            or 0.300

        local confirmation_ends_at =
            activation_at
            + confirmation_window

        task.spawn(function()

            local matched_velocity = nil

            repeat

                if state.pending_token ~= token
                    or not ENABLED
                    or plr.Character ~= character
                then
                    return
                end

                matched_velocity =
                    find_wing_soar_candidate(
                        profile,
                        candidates,
                        activation_at,
                        confirmation_ends_at,
                        profile.initial_velocity_y_min or 175,
                        profile.initial_velocity_y_max or 185
                    )

                if matched_velocity then
                    break
                end

                task.wait()

            until os.clock() > confirmation_ends_at

            --------------------------------------------------
            -- INITIAL 175-185 Y VELOCITY NEVER APPEARED.
            -- DO NOT SHOW A FALSE COOLDOWN.
            --------------------------------------------------

            if not matched_velocity then

                if state.pending_token == token then

                    state.pending_at = nil
                    state.pending_button = nil

                    state.pending_required_instance_seen = false
                    state.pending_required_instance_2_seen = false
                    state.pending_animation_seen = false

                    state.move_in_progress = false

                    disconnect_wing_soar_connection(state)
                end

                return
            end

            local cached_button =
                state.pending_button

            candidates[matched_velocity] = nil

            --------------------------------------------------
            -- INITIAL USE CONFIRMED. INVALIDATE LEFTCLICK
            -- PENDING, THEN BEGIN THE TWO RECAST WINDOWS.
            --------------------------------------------------

            state.pending_at = nil
            state.pending_button = nil

            state.pending_required_instance_seen = false
            state.pending_required_instance_2_seen = false
            state.pending_animation_seen = false

            state.pending_token += 1

            start_wing_soar_recast_resolution(
                profile,
                state,
                cached_button,
                character
            )
        end)
    end

    --------------------------------------------------
    -- PASSIVE INSTANCE + ANIMATION CONFIRMATION
    --
    -- Used by moves such as Verto that do not have a reliable click
    -- remote. Either signal can arrive first. The first valid signal
    -- opens the 0.750s pairing window; the second must arrive before
    -- that window expires.
    --------------------------------------------------

    local function register_passive_instance_animation_signal(
        profile,
        state,
        signal_name
    )

        if not ENABLED or not profile or not state then
            return false
        end

        local now = os.clock()

        if state.passive_lock_until
            and now < state.passive_lock_until
        then
            return false
        end

        local window =
            profile.confirmation_window
            or profile.required_instance_window
            or profile.animation_window
            or 0.750

        if not state.passive_signal_started_at
            or now - state.passive_signal_started_at > window
        then
            state.passive_signal_started_at = now
            state.passive_animation_seen = false
            state.passive_instance_seen = false
        end

        if signal_name == "animation" then
            state.passive_animation_seen = true
        elseif signal_name == "instance" then
            state.passive_instance_seen = true
        end

        if not state.passive_animation_seen
            or not state.passive_instance_seen
        then
            return false
        end

        local elapsed =
            now - state.passive_signal_started_at

        if elapsed < 0 or elapsed > window then
            return false
        end

        state.passive_signal_started_at = nil
        state.passive_animation_seen = false
        state.passive_instance_seen = false

        -- Prevent the same physical activation from being confirmed twice
        -- if duplicate replication/animation callbacks arrive together.
        state.passive_lock_until = now + 1.0

        start_cooldown(
            profile,
            find_hotbar_button(profile.name)
        )

        return true
    end

    --------------------------------------------------
    -- INSTANCE + ANIMATION CONFIRMATION
    --------------------------------------------------

    local function try_confirm_instance_and_animation(
        profile,
        state
    )

        if not state
            or not state.pending_at
        then
            return false
        end

        if not state.pending_animation_seen
            or not state.pending_required_instance_seen
        then
            return false
        end

        local window =
            profile.required_instance_window
            or profile.animation_window

        local elapsed =
            os.clock()
            - state.pending_at

        if elapsed < 0
            or elapsed > window
        then
            return false
        end

        local cached_button =
            state.pending_button

        --------------------------------------------------
        -- INVALIDATE BEFORE START
        --------------------------------------------------

        state.pending_at = nil
        state.pending_button = nil

        state.pending_token += 1

        state.pending_required_instance_seen =
            false

        state.pending_required_instance_2_seen =
            false

        state.pending_animation_seen =
            false

        --------------------------------------------------
        -- START CD
        --------------------------------------------------

        start_cooldown(
            profile,
            cached_button
        )

        return true
    end

    --------------------------------------------------
    -- INSTANCE + INSTANCE CONFIRMATION
    --------------------------------------------------

    local function try_confirm_instance_pair(
        profile,
        state
    )

        if not state
            or not state.pending_at
        then
            return false
        end

        if not state.pending_required_instance_seen
            or not state.pending_required_instance_2_seen
        then
            return false
        end

        local window =
            profile.confirmation_window
            or profile.required_instance_window
            or 0

        local elapsed =
            os.clock()
            - state.pending_at

        if elapsed < 0
            or elapsed > window
        then
            return false
        end

        local cached_button =
            state.pending_button

        --------------------------------------------------
        -- INVALIDATE BEFORE START
        --------------------------------------------------

        state.pending_at = nil
        state.pending_button = nil

        state.pending_token += 1

        state.pending_required_instance_seen =
            false

        state.pending_required_instance_2_seen =
            false

        state.pending_animation_seen =
            false

        --------------------------------------------------
        -- START CD
        --------------------------------------------------

        start_cooldown(
            profile,
            cached_button
        )

        return true
    end

    --------------------------------------------------
    -- GRAPPLE CORD TARGET CHECK
    --------------------------------------------------

    local function get_attachment_part(attachment)

        if typeof(attachment) ~= "Instance"
            or not attachment:IsA("Attachment")
        then
            return nil
        end

        local parent = attachment.Parent

        if parent and parent:IsA("BasePart") then
            return parent
        end

        return parent
            and parent:FindFirstAncestorWhichIsA("BasePart")
            or nil
    end

    local function grapple_cord_attached_to_other_torso(beam)

        if not beam
            or not beam:IsA("Beam")
        then
            return false
        end

        local character = plr.Character

        if not character then
            return false
        end

        local attachment_0 = beam.Attachment0
        local attachment_1 = beam.Attachment1

        local part_0 = get_attachment_part(attachment_0)
        local part_1 = get_attachment_part(attachment_1)

        local function is_other_torso(part)

            return part
                and part.Name == "Torso"
                and not part:IsDescendantOf(character)
        end

        return is_other_torso(part_0)
            or is_other_torso(part_1)
    end


    --------------------------------------------------
    -- GRAPPLE CORD + 7.4s VELOCITY CONFIRMATION
    --------------------------------------------------

    local function grapple_exact_vector3(value, expected)

        return typeof(value) == "Vector3"
            and value.X == expected.X
            and value.Y == expected.Y
            and value.Z == expected.Z
    end

    local function grapple_local_high_velocity_matches(profile, mover, character)

        if not mover
            or not mover.Parent
            or not mover:IsA("BodyVelocity")
            or mover.Name ~= (
                profile.grapple_velocity_name
                or "GrappleVelocity"
            )
            or not character
            or not mover:IsDescendantOf(character)
        then
            return false
        end

        local expected_force =
            Vector3.new(1000000, 1000000, 1000000)

        if not grapple_exact_vector3(
            mover.MaxForce,
            expected_force
        ) then
            return false
        end

        local velocity = mover.Velocity

        if typeof(velocity) ~= "Vector3" then
            return false
        end

        local threshold =
            profile.grapple_velocity_y_threshold
            or 53

        return velocity.Y > threshold
    end

    local function start_grapple_cord_velocity_window(profile, state, token)

        local activation_at = state.pending_at
        local cached_button = state.pending_button
        local window = profile.confirmation_window or 0.850
        local character = plr.Character

        if not activation_at or not character then
            return
        end

        --------------------------------------------------
        -- SNAPSHOT EXISTING CONNECTED CORD
        --
        -- This keeps the working torso-grapple spam protection without
        -- changing the older 7.4s GrappleVelocity detection behavior.
        --------------------------------------------------

        local initial_cord_connected = false

        do
            local left_arm =
                FindFirstChild(character, profile.grapple_cord_parent_name or "Left Arm")

            local cord = left_arm
                and FindFirstChild(left_arm, profile.grapple_cord_name or "Cord")

            initial_cord_connected =
                cord
                and cord:IsA("Beam")
                and grapple_cord_attached_to_other_torso(cord)
                or false
        end

        -- If a Cord is already connected when a spam click arrives, do not
        -- count it again until it has first become disconnected.
        local cord_armed = not initial_cord_connected

        task.spawn(function()

            local deadline = activation_at + window
            local connected_cord_seen = false
            local high_velocity_seen = false

            while ENABLED
                and state.pending_token == token
                and plr.Character == character
                and os.clock() <= deadline
            do
                --------------------------------------------------
                -- PRIORITY 1: NEW CONNECTED GRAPPLE CORD -> 6.3s
                --------------------------------------------------

                local left_arm =
                    FindFirstChild(character, profile.grapple_cord_parent_name or "Left Arm")

                local cord = left_arm
                    and FindFirstChild(left_arm, profile.grapple_cord_name or "Cord")

                local cord_connected =
                    cord
                    and cord:IsA("Beam")
                    and grapple_cord_attached_to_other_torso(cord)
                    or false

                if not cord_connected then
                    cord_armed = true
                elseif cord_armed then
                    connected_cord_seen = true
                    break
                end

                --------------------------------------------------
                -- PRIORITY 2: LOCAL GrappleVelocity -> 7.4s
                --
                -- Keep the older working 7.4s detection path exactly:
                -- poll the character each frame for GrappleVelocity and
                -- accept it whenever its replicated values match.
                --------------------------------------------------

                local grapple_velocity =
                    FindFirstChild(
                        character,
                        profile.grapple_velocity_name or "GrappleVelocity",
                        true
                    )

                if grapple_velocity
                    and grapple_local_high_velocity_matches(
                        profile,
                        grapple_velocity,
                        character
                    )
                then
                    high_velocity_seen = true
                end

                rs.Heartbeat:Wait()
            end

            if not ENABLED
                or state.pending_token ~= token
                or plr.Character ~= character
            then
                return
            end

            local cooldown = nil

            -- Connected torso grapple always has priority over the
            -- high-Y GrappleVelocity result.
            if connected_cord_seen then
                cooldown = profile.grapple_hit_cooldown or 6.3
            elseif high_velocity_seen then
                cooldown = profile.grapple_high_cooldown or 7.55
            end

            --------------------------------------------------
            -- INVALIDATE BEFORE START / EXIT
            --------------------------------------------------

            state.pending_at = nil
            state.pending_button = nil
            state.pending_token += 1

            state.pending_required_instance_seen = false
            state.pending_required_instance_2_seen = false
            state.pending_animation_seen = false

            if not cooldown then
                return
            end

            -- Small resolved-use lock: the same physical grapple can emit several
            -- LeftClick calls while its Cord/velocity still exists. Do not let those
            -- clicks restart the visual. A real later grapple occurs far after this.
            state.grapple_retrigger_until = os.clock() + 1.0

            start_cooldown(
                profile,
                cached_button,
                cooldown
            )
        end)
    end

    --------------------------------------------------
    -- CHARACTER DESCENDANT ADDED
    --------------------------------------------------

    local function handle_character_descendant(object)

        if not ENABLED then
            return
        end

        --------------------------------------------------
        -- SNAP SIGNALS
        --------------------------------------------------

        snap_system.handle_descendant_added(object)

        --------------------------------------------------
        -- NORMAL/SPECIAL MOVE SIGNALS
        --------------------------------------------------

        for _, profile
            in pairs(profiles)
        do

            --------------------------------------------------
            -- PASSIVE INSTANCE + ANIMATION
            --------------------------------------------------

            if profile.special == "passive_instance_and_animation" then

                local state =
                    states[profile.name]

                local parent_ok =
                    not profile.required_parent_name
                    or (
                        object.Parent
                        and object.Parent.Name ==
                            profile.required_parent_name
                    )

                local class_ok =
                    not profile.required_instance_class
                    or object:IsA(
                        profile.required_instance_class
                    )

                if state
                    and parent_ok
                    and class_ok
                    and object.Name ==
                        profile.required_instance_name
                then
                    register_passive_instance_animation_signal(
                        profile,
                        state,
                        "instance"
                    )
                end

            --------------------------------------------------
            -- INSTANCE + ANIMATION
            --------------------------------------------------

            elseif profile.special == "instance_and_animation" then

                local state =
                    states[profile.name]

                if state
                    and state.pending_at
                then

                    local elapsed =
                        os.clock()
                        - state.pending_at

                    local window =
                        profile.required_instance_window
                        or profile.animation_window

                    local parent_ok =
                        not profile.required_parent_name
                        or (
                            object.Parent
                            and object.Parent.Name ==
                                profile.required_parent_name
                        )

                    local class_ok =
                        not profile.required_instance_class
                        or object:IsA(
                            profile.required_instance_class
                        )

                    if elapsed >= 0
                        and elapsed <= window
                        and object.Name ==
                            profile.required_instance_name
                        and parent_ok
                        and class_ok
                    then

                        state.pending_required_instance_seen =
                            true

                        try_confirm_instance_and_animation(
                            profile,
                            state
                        )

                    end

                end

            --------------------------------------------------
            -- INSTANCE + INSTANCE
            --------------------------------------------------

            elseif profile.special == "instance_pair" then

                local state =
                    states[profile.name]

                if state
                    and state.pending_at
                then

                    local elapsed =
                        os.clock()
                        - state.pending_at

                    local window =
                        profile.confirmation_window
                        or 0

                    if elapsed >= 0
                        and elapsed <= window
                    then

                        local parent_ok =
                            not profile.required_parent_name
                            or (
                                object.Parent
                                and object.Parent.Name ==
                                    profile.required_parent_name
                            )

                        if parent_ok
                            and object.Name ==
                                profile.required_instance_name
                            and (
                                not profile.required_instance_class
                                or object:IsA(
                                    profile.required_instance_class
                                )
                            )
                        then

                            state.pending_required_instance_seen =
                                true

                        elseif parent_ok
                            and object.Name ==
                                profile.required_instance_name_2
                            and (
                                not profile.required_instance_class_2
                                or object:IsA(
                                    profile.required_instance_class_2
                                )
                            )
                        then

                            state.pending_required_instance_2_seen =
                                true
                        end

                        try_confirm_instance_pair(
                            profile,
                            state
                        )
                    end
                end

            --------------------------------------------------
            -- SINGLE INSTANCE CONFIRMATION
            --------------------------------------------------

            elseif profile.special == "instance_single" then

                local state =
                    states[profile.name]

                if state
                    and state.pending_at
                then

                    local elapsed =
                        os.clock()
                        - state.pending_at

                    local window =
                        profile.confirmation_window
                        or profile.required_instance_window
                        or 0

                    local parent_ok =
                        not profile.required_parent_name
                        or (
                            object.Parent
                            and object.Parent.Name ==
                                profile.required_parent_name
                        )

                    local class_ok =
                        not profile.required_instance_class
                        or object:IsA(
                            profile.required_instance_class
                        )

                    local value_ok =
                        profile.required_instance_value == nil
                        or (
                            object:IsA("ValueBase")
                            and object.Value ==
                                profile.required_instance_value
                        )

                    if elapsed >= 0
                        and elapsed <= window
                        and parent_ok
                        and object.Name ==
                            profile.required_instance_name
                        and class_ok
                        and value_ok
                    then

                        local cached_button =
                            state.pending_button

                        --------------------------------------------------
                        -- INVALIDATE BEFORE START
                        --------------------------------------------------

                        state.pending_at = nil
                        state.pending_button = nil

                        state.pending_token += 1

                        state.pending_required_instance_seen =
                            false

                        state.pending_required_instance_2_seen =
                            false

                        state.pending_animation_seen =
                            false

                        --------------------------------------------------
                        -- START CD
                        --------------------------------------------------

                        start_cooldown(
                            profile,
                            cached_button
                        )
                    end
                end

            --------------------------------------------------
            -- GRAPPLE CORD
            --------------------------------------------------

            elseif profile.special == "grapple_cord_cooldown" then

                local state =
                    states[profile.name]

                if state
                    and state.pending_at
                    and object:IsA("Beam")
                then

                    local elapsed =
                        os.clock() - state.pending_at

                    local window =
                        profile.confirmation_window
                        or 0.700

                    local parent_ok =
                        object.Parent
                        and object.Parent.Name == (
                            profile.grapple_cord_parent_name
                            or "Left Arm"
                        )

                    if elapsed >= 0
                        and elapsed <= window
                        and parent_ok
                        and object.Name == (
                            profile.grapple_cord_name
                            or "Cord"
                        )
                    then

                        local activation_token =
                            state.pending_token

                        local activation_at =
                            state.pending_at

                        local cached_button =
                            state.pending_button

                        local deadline =
                            activation_at + window

                        -- Cord endpoints can populate a frame or two after the Beam
                        -- itself is parented. Watch only until the original 0.700s
                        -- Grapple confirmation deadline.
                        task.spawn(function()

                            local attached_to_target_torso = false

                            while ENABLED
                                and state.pending_token == activation_token
                                and os.clock() <= deadline
                            do

                                if object.Parent
                                    and grapple_cord_attached_to_other_torso(object)
                                then
                                    attached_to_target_torso = true
                                    break
                                end

                                if not object.Parent then
                                    break
                                end

                                rs.Heartbeat:Wait()
                            end

                            if not ENABLED
                                or state.pending_token ~= activation_token
                            then
                                return
                            end

                            local cooldown =
                                attached_to_target_torso
                                and (
                                    profile.grapple_hit_cooldown
                                    or 6.3
                                )
                                or (
                                    profile.grapple_miss_cooldown
                                    or 7.55
                                )

                            --------------------------------------------------
                            -- INVALIDATE BEFORE START
                            --------------------------------------------------

                            state.pending_at = nil
                            state.pending_button = nil

                            state.pending_token += 1

                            state.pending_required_instance_seen =
                                false

                            state.pending_required_instance_2_seen =
                                false

                            state.pending_animation_seen =
                                false

                            --------------------------------------------------
                            -- START VARIABLE GRAPPLE COOLDOWN
                            --------------------------------------------------

                            start_cooldown(
                                profile,
                                cached_button,
                                cooldown
                            )
                        end)
                    end
                end

            --------------------------------------------------
            -- GRAPPLE VELOCITY
            --------------------------------------------------

            elseif profile.special == "grapple_velocity_cooldown" then

                local state =
                    states[profile.name]

                if state
                    and state.pending_at
                    and object:IsA("BodyVelocity")
                then

                    local activation_token =
                        state.pending_token

                    local activation_at =
                        state.pending_at

                    local cached_button =
                        state.pending_button

                    local window =
                        profile.confirmation_window
                        or 0.7

                    -- DescendantAdded can happen before Name/Velocity finish
                    -- initializing, so keep checking this newly-added mover until
                    -- the 0.7s activation window expires.
                    task.spawn(function()

                        while ENABLED
                            and state.pending_token == activation_token
                            and state.pending_at == activation_at
                            and object.Parent
                        do

                            local elapsed =
                                os.clock() - activation_at

                            if elapsed < 0
                                or elapsed > window
                            then
                                return
                            end

                            if object.Name == (
                                profile.grapple_velocity_name
                                or "GrappleVelocity"
                            ) then

                                local velocity =
                                    object.Velocity

                                if typeof(velocity) == "Vector3" then

                                    local threshold =
                                        profile.grapple_velocity_y_threshold
                                        or 67

                                    local cooldown =
                                        velocity.Y > threshold
                                        and (
                                            profile.grapple_high_cooldown
                                            or 7.55
                                        )
                                        or (
                                            profile.grapple_low_cooldown
                                            or 6.2
                                        )

                                    --------------------------------------------------
                                    -- INVALIDATE BEFORE START
                                    --------------------------------------------------

                                    state.pending_at = nil
                                    state.pending_button = nil

                                    state.pending_token += 1

                                    state.pending_required_instance_seen =
                                        false

                                    state.pending_required_instance_2_seen =
                                        false

                                    state.pending_animation_seen =
                                        false

                                    --------------------------------------------------
                                    -- START VARIABLE GRAPPLE COOLDOWN
                                    --------------------------------------------------

                                    start_cooldown(
                                        profile,
                                        cached_button,
                                        cooldown
                                    )

                                    return
                                end
                            end

                            rs.Heartbeat:Wait()
                        end
                    end)
                end

            --------------------------------------------------
            -- GREAT CYCLONE
            --------------------------------------------------

            elseif profile.special == "great_cyclone_release_sound_end" then

                local state =
                    states[profile.name]

                if state
                    and state.special_active
                    and state.special_started_at
                    and not state.great_cyclone_sound
                then

                    local elapsed =
                        os.clock()
                        - state.special_started_at

                    local window =
                        profile.release_sound_window
                        or 2.25

                    if elapsed >= 0
                        and elapsed <= window
                        and object:IsA("Sound")
                        and object.Name == (
                            profile.release_sound_name
                            or "ReleaseSound"
                        )
                    then

                        watch_great_cyclone_release_sound(
                            profile,
                            state,
                            object
                        )
                    end
                end

            --------------------------------------------------
            -- RIFT DIVE
            --------------------------------------------------

            elseif profile.special == "rift_dive" then

                local state =
                    states[profile.name]

                if state then

                    local now =
                        os.clock()

                    --------------------------------------------------
                    -- EARLY SPEEDLOCK
                    --------------------------------------------------

                    if object.Name == "SpeedLock"
                        and state.pending_at
                    then

                        local pending_elapsed =
                            now
                            - state.pending_at

                        local baseline =
                            state.pending_speedlock_baseline

                        if pending_elapsed >= 0
                            and pending_elapsed <= (
                                profile.speedlock_window
                                or 1.25
                            )
                            and (
                                not baseline
                                or not baseline[object]
                            )
                        then

                            state.pending_speedlock_seen =
                                true

                        end

                    end

                    --------------------------------------------------
                    -- SPECIAL ACTIVE SIGNALS
                    --------------------------------------------------

                    if state.special_active
                        and state.special_started_at
                    then

                        local elapsed =
                            now
                            - state.special_started_at

                        --------------------------------------------------
                        -- EMERGE CREATED
                        --------------------------------------------------

                        if object:IsA("Sound")
                            and object.Name == "Emerge"
                            and elapsed >= 0
                            and elapsed <= (
                                profile.emerge_window
                                or 10
                            )
                        then

                            watch_emerge_sound(
                                profile,
                                state,
                                object
                            )

                        end

                        --------------------------------------------------
                        -- SPEEDLOCK ADDED
                        --------------------------------------------------

                        if object.Name == "SpeedLock"
                            and elapsed >= 0
                            and elapsed <= (
                                profile.speedlock_window
                                or 1.25
                            )
                            and (
                                not state.speedlock_baseline
                                or not state.speedlock_baseline[object]
                            )
                        then

                            state.speedlock_seen =
                                true

                        end

                    end

                end

            end

        end
    end

    --------------------------------------------------
    -- ANIMATION CONFIRMATION
    --------------------------------------------------

    local function confirm_animation(
        animation_id,
        track
    )

        if not ENABLED then
            return
        end

        local matching_profiles =
            animations[animation_id]

        if not matching_profiles then
            return
        end

        local now =
            os.clock()

        for _, profile
            in ipairs(matching_profiles)
        do

            local state =
                states[profile.name]

            if state
                and profile.special == "passive_instance_and_animation"
            then
                register_passive_instance_animation_signal(
                    profile,
                    state,
                    "animation"
                )
            else

                local pending_at =
                    state
                    and state.pending_at

                if pending_at then

                    local delta =
                        now - pending_at

                if delta >= 0
                    and delta <= profile.animation_window
                then

                    --------------------------------------------------
                    -- TWO-SIGNAL MOVE
                    --------------------------------------------------

                    if profile.special == "instance_and_animation" then

                        state.pending_animation_seen =
                            true

                        try_confirm_instance_and_animation(
                            profile,
                            state
                        )

                    --------------------------------------------------
                    -- GREAT CYCLONE
                    --------------------------------------------------

                    elseif profile.special == "great_cyclone_release_sound_end" then

                        local cached_button =
                            state.pending_button

                        --------------------------------------------------
                        -- CLEAR LEFTCLICK PENDING; THE ANIMATION IS
                        -- CONFIRMED, BUT THE MOVE IS NOT YET CONFIRMED.
                        --------------------------------------------------

                        state.pending_at = nil
                        state.pending_button = nil

                        state.pending_token += 1

                        state.pending_speedlock_seen =
                            false

                        state.pending_speedlock_baseline =
                            nil

                        state.pending_required_instance_seen =
                            false

                        state.pending_required_instance_2_seen =
                            false

                        state.pending_animation_seen =
                            false

                        start_great_cyclone_resolution(
                            profile,
                            state,
                            cached_button
                        )

                    --------------------------------------------------
                    -- NORMAL / RIFT DIVE
                    --------------------------------------------------

                    else

                        local cached_button =
                            state.pending_button

                        local activation_at =
                            pending_at

                        local early_speedlock_seen =
                            state.pending_speedlock_seen

                        local speedlock_baseline =
                            state.pending_speedlock_baseline

                        --------------------------------------------------
                        -- CLEAR PENDING
                        --------------------------------------------------

                        state.pending_at = nil
                        state.pending_button = nil

                        state.pending_token += 1

                        state.pending_speedlock_seen =
                            false

                        state.pending_speedlock_baseline =
                            nil

                        --------------------------------------------------
                        -- RIFT DIVE
                        --------------------------------------------------

                        if profile.special == "rift_dive" then

                            mark_special_animation_active(
                                state,
                                track
                            )

                            start_rift_dive_resolution(
                                profile,
                                state,
                                cached_button,
                                activation_at,
                                early_speedlock_seen,
                                speedlock_baseline
                            )

                        --------------------------------------------------
                        -- NORMAL MOVE
                        --------------------------------------------------

                        else

                            start_cooldown(
                                profile,
                                cached_button
                            )

                        end

                    end

                end

            end

            end

        end
    end

    --------------------------------------------------
    -- CHARACTER SETUP
    --------------------------------------------------

    local function setup_character(character)

        --------------------------------------------------
        -- OLD ANIMATION CONNECTION
        --------------------------------------------------

        if animation_connection then

            pcall(function()
                animation_connection:Disconnect()
            end)

            animation_connection = nil
        end

        --------------------------------------------------
        -- OLD DESCENDANT CONNECTION
        --------------------------------------------------

        if descendant_connection then

            pcall(function()
                descendant_connection:Disconnect()
            end)

            descendant_connection = nil
        end

        --------------------------------------------------
        -- CLEAR OLD STATE
        --------------------------------------------------

        clear_all()
        snap_system.reset_all()

        --------------------------------------------------
        -- CONNECT IMMEDIATELY
        --------------------------------------------------

        descendant_connection =
            character.DescendantAdded:Connect(function(object)

                local success, err =
                    pcall(
                        handle_character_descendant,
                        object
                    )

                if not success then
                    warn(
                        "[Cooldown Visualizer] Descendant error:",
                        err
                    )
                end

            end)

        --------------------------------------------------
        -- ANIMATOR
        --------------------------------------------------

        task.spawn(function()

            local success, err =
                pcall(function()

                    local humanoid =
                        character:FindFirstChildOfClass(
                            "Humanoid"
                        )
                        or character:WaitForChild(
                            "Humanoid",
                            10
                        )

                    if not humanoid
                        or character ~= plr.Character
                    then
                        return
                    end

                    local animator =
                        humanoid:FindFirstChildOfClass(
                            "Animator"
                        )
                        or humanoid:WaitForChild(
                            "Animator",
                            5
                        )

                    if not animator
                        or character ~= plr.Character
                    then
                        return
                    end

                    animation_connection =
                        animator.AnimationPlayed:Connect(
                            function(track)

                                local callback_success,
                                    callback_error =
                                    pcall(function()

                                        local animation =
                                            track.Animation

                                        if not animation then
                                            return
                                        end

                                        local animation_id =
                                            clean_animation_id(
                                                animation.AnimationId
                                            )

                                        snap_system.handle_animation(
                                            animation_id
                                        )

                                        confirm_animation(
                                            animation_id,
                                            track
                                        )

                                    end)

                                if not callback_success then

                                    warn(
                                        "[Cooldown Visualizer] Animation error:",
                                        callback_error
                                    )

                                end

                            end
                        )

                end)

            if not success then

                warn(
                    "[Cooldown Visualizer] Animator setup error:",
                    err
                )

            end

        end)
    end

    --------------------------------------------------
    -- REMOTE HANDLER
    --------------------------------------------------

    local function handle_remote(
        event,
        remotes_folder
    )

        if not ENABLED then
            return
        end

        --------------------------------------------------
        -- SNAP RIGHTCLICK
        --------------------------------------------------

        snap_system.handle_remote(
            event,
            remotes_folder
        )

        --------------------------------------------------
        -- NORMAL MOVE INPUT
        --
        -- Most moves activate through LeftClick. A profile may
        -- explicitly opt into another skill remote (Verto uses
        -- RightClick/M2) while still using the normal RED cooldown.
        --------------------------------------------------

        if not remotes_folder
            or event.Parent ~= remotes_folder
        then
            return
        end

        local profile =
            get_equipped_profile()

        if not profile then
            return
        end

        -- Passive moves (Verto) are confirmed from their replicated
        -- animation + instance signals and do not arm from click remotes.
        if profile.special == "passive_instance_and_animation" then
            return
        end

        local activation_remote =
            profile.activation_remote
            or "LeftClick"

        if event.Name ~= activation_remote then
            return
        end

        local state =
            states[profile.name]

        if not state then
            return
        end

        --------------------------------------------------
        -- GRAPPLE SPAM-CLICK GUARD
        --
        -- Once one grapple has been positively confirmed, ignore the
        -- extra LeftClick calls generated by spam-clicking for a short
        -- period so the same Cord cannot restart the cooldown visual.
        --------------------------------------------------

        if profile.special == "grapple_cord_velocity_cooldown"
            and state.grapple_retrigger_until
            and os.clock() < state.grapple_retrigger_until
        then
            return
        end

        --------------------------------------------------
        -- SPECIAL MOVE RETRIGGER PROTECTION
        --------------------------------------------------

        if profile.special
            and profile.block_retrigger_while_special ~= false
            and (
                state.special_active
                or state.move_in_progress
            )
        then
            return
        end

        --------------------------------------------------
        -- NEW ACTIVATION
        --------------------------------------------------

        state.pending_token += 1

        local token =
            state.pending_token

        --------------------------------------------------
        -- CACHE EXACT HOTBAR BUTTON
        --------------------------------------------------

        state.pending_button =
            find_hotbar_button(
                profile.name
            )

        state.pending_at =
            os.clock()

        state.pending_required_instance_seen =
            false

        state.pending_required_instance_2_seen =
            false

        state.pending_animation_seen =
            false

        --------------------------------------------------
        -- GRAPPLE CORD + VELOCITY CONFIRMATION
        --------------------------------------------------

        if profile.special == "grapple_cord_velocity_cooldown" then

            start_grapple_cord_velocity_window(
                profile,
                state,
                token
            )

            return
        end

        --------------------------------------------------
        -- WING SOAR VELOCITY CONFIRMATION
        --------------------------------------------------

        if profile.special == "wing_soar_velocity_recasts" then

            start_wing_soar_initial_scan(
                profile,
                state,
                token
            )

            return
        end

        --------------------------------------------------
        -- RIFT DIVE SPEEDLOCK BASELINE
        --------------------------------------------------

        if profile.special == "rift_dive" then

            local baseline = {}

            local character =
                plr.Character

            if character then

                for _, object
                    in ipairs(character:GetDescendants())
                do

                    if object.Name == "SpeedLock" then
                        baseline[object] = true
                    end

                end

            end

            state.pending_speedlock_baseline =
                baseline

            state.pending_speedlock_seen =
                false
        end

        --------------------------------------------------
        -- CONFIRMATION WINDOW TIMEOUT
        --------------------------------------------------

        local confirmation_timeout =
            profile.confirmation_window
            or profile.animation_window

        task.delay(
            confirmation_timeout,

            function()

                if state.pending_token == token then

                    state.pending_at = nil
                    state.pending_button = nil

                    state.pending_speedlock_seen =
                        false

                    state.pending_speedlock_baseline =
                        nil

                    state.pending_required_instance_seen =
                        false

                    state.pending_required_instance_2_seen =
                        false

                    state.pending_animation_seen =
                        false

                end

            end
        )
    end

    --------------------------------------------------
    -- ENABLE / DISABLE
    --------------------------------------------------

    local function set_enabled(enabled)

        ENABLED =
            enabled and true or false

        if not ENABLED then

            clear_all()

            snap_system.reset_all()

            remove_ui_overlays()

        end
    end

    --------------------------------------------------
    -- INITIAL CHARACTER
    --------------------------------------------------

    if plr.Character then

        setup_character(
            plr.Character
        )

    end

    --------------------------------------------------
    -- RESPAWN
    --------------------------------------------------

    connect(
        plr.CharacterAdded,

        function(character)

            local success, err =
                pcall(
                    setup_character,
                    character
                )

            if not success then

                warn(
                    "[Cooldown Visualizer] Character setup error:",
                    err
                )

            end

        end
    )

    --------------------------------------------------
    -- REMOTE INPUT IS ROUTED THROUGH WARYAHUB'S EXISTING
    -- FIRESERVER HOOK. THIS AVOIDS STACKING HOOKS.
    --------------------------------------------------

    --------------------------------------------------
    -- PUBLIC API
    --------------------------------------------------

    cheat_client.cooldown_visualizer = {

        handle_remote =
            function(event, remotes_folder)

                if not ENABLED then
                    return
                end

                local success, err =
                    pcall(
                        handle_remote,
                        event,
                        remotes_folder
                    )

                if not success then
                    warn(
                        "[Cooldown Visualizer] Remote detection error:",
                        err
                    )
                end

            end,

        set_enabled =
            function(enabled)

                local success, err =
                    pcall(
                        set_enabled,
                        enabled
                    )

                if not success then

                    warn(
                        "[Cooldown Visualizer] SetEnabled error:",
                        err
                    )

                end

            end,

        -- Read-only bridge used by the extended hotbar.  This deliberately
        -- exposes timing, not GUI instances, so custom cards can be rebuilt
        -- without disturbing the cooldown detector/tweens on Rogue's UI.
        get_active_visuals =
            function(move_name)
                if not ENABLED or type(move_name) ~= "string" or move_name == "" then
                    return nil
                end

                local now = os.clock()
                local result = nil
                local state = states[move_name]

                if state then
                    local total = tonumber(state.cooldown_duration) or 0
                    local remaining = (tonumber(state.cooldown_end_at) or 0) - now

                    if total > 0 and remaining > 0 then
                        result = result or {}
                        result.normal = {
                            duration = total,
                            remaining = math.min(remaining, total),
                        }
                    end
                end

                if snap_system and snap_system.get_active_visual then
                    local snap = snap_system.get_active_visual(move_name)
                    if snap then
                        result = result or {}
                        result.snap = snap
                    end
                end

                return result
            end,

        cleanup =
            function()

                local success, err =
                    pcall(function()

                        set_enabled(false)

                        ------------------------------------------
                        -- ANIMATION
                        ------------------------------------------

                        if animation_connection then

                            pcall(function()
                                animation_connection:Disconnect()
                            end)

                            animation_connection = nil
                        end

                        ------------------------------------------
                        -- DESCENDANT
                        ------------------------------------------

                        if descendant_connection then

                            pcall(function()
                                descendant_connection:Disconnect()
                            end)

                            descendant_connection = nil
                        end

                        ------------------------------------------
                        -- OTHER CONNECTIONS
                        ------------------------------------------

                        disconnect_all_connections()

                    end)

                if not success then

                    warn(
                        "[Cooldown Visualizer] Cleanup error:",
                        err
                    )

                end

            end,
    }

    --------------------------------------------------
    -- LOADED
    --------------------------------------------------

    print(
        "[Cooldown Visualizer] Loaded"
    )

end)

--------------------------------------------------
-- OUTER PCALL RESULT
--------------------------------------------------

if not CooldownVisualizerSuccess then

    warn(
        "[Cooldown Visualizer] Failed to initialize:",
        CooldownVisualizerError
    )

end
