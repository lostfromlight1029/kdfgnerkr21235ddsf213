            local cons = getconnections(rps.Requests.DaysSurvivedChanged.OnClientEvent)
            if not cons or #cons == 0 then
                return self.day_cache
            end

            for _, v in next, cons do
                local ok, value = pcall(getupvalue, v.Function, 2)
