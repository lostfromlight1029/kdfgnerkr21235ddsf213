                end
                function this:ReadFloat32()
                    return this:ReadFloat(23, 8)
                end
    
                function this:WriteFloat64(f)
                    this:WriteFloat(52, 11, f)
                end
                function this:ReadFloat64()
                    return this:ReadFloat(52, 11)
                end
    
