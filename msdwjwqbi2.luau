                local function is_rift_dive_active()
                    local character = plr.Character
                    local boosts = character and FindFirstChild(character, "Boosts")
                    if not boosts then
                        return false
                    end

                    -- Rift Dive is active while ANY live SpeedLock value is 40 or higher.
                    -- Scan every child because Rogue can have multiple values named SpeedLock.
                    for _, speedLock in ipairs(boosts:GetChildren()) do
                        if speedLock.Name == "SpeedLock"
