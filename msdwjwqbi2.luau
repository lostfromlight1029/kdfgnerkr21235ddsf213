            -- Banned kick logger
            -- Captures the kick/disconnect reason and posts every player seen in the
            -- server at that moment to the configured main webhook.
            do
                local banned_kick_reported = false
                local banned_kick_roster_cache = {}
                local watched_prompt_guis = setmetatable({}, {__mode = "k"})
                local watched_prompt_text = setmetatable({}, {__mode = "k"})

                local function remember_player(player)
                    if not player then return end

                    banned_kick_roster_cache[player.UserId] = {
                        name = player.Name,
                        user_id = player.UserId,
                        last_seen = os.clock(),
                    }
                end

                local function refresh_roster_cache()
                    local now = os.clock()

                    for _, player in ipairs(plrs:GetPlayers()) do
                        remember_player(player)
                    end

                    -- Keep a short grace window so a disconnect teardown cannot erase
                    -- the roster before the kick reason becomes visible.
                    for user_id, data in pairs(banned_kick_roster_cache) do
                        if now - (data.last_seen or 0) > 10 then
                            banned_kick_roster_cache[user_id] = nil
                        end
                    end
                end

                refresh_roster_cache()

                utility:Connection(plrs.PlayerAdded, function(player)
                    remember_player(player)
                end)

                utility:Connection(plrs.PlayerRemoving, function(player)
                    -- Do not immediately delete it. A real kick can cause Roblox to begin
                    -- tearing down Players before the disconnect prompt text is readable.
                    local cached = banned_kick_roster_cache[player.UserId]
                    if cached then
                        cached.last_seen = os.clock()
                    else
                        remember_player(player)
                    end
                end)

                task.spawn(function()
                    while shared and not shared.is_unloading and not banned_kick_reported do
                        refresh_roster_cache()
                        task.wait(0.25)
                    end
                end)

                local function get_banned_kick_roster()
                    local combined = {}
                    local now = os.clock()

                    -- Prefer the live Players list first.
                    for _, player in ipairs(plrs:GetPlayers()) do
                        combined[player.UserId] = {
                            name = player.Name,
                            user_id = player.UserId,
                        }
                        remember_player(player)
                    end

                    -- Also merge the very recent cache. This is what protects the list
                    -- if Roblox starts removing Player objects during disconnect teardown.
                    for user_id, data in pairs(banned_kick_roster_cache) do
                        if now - (data.last_seen or 0) <= 2 then
                            combined[user_id] = combined[user_id] or {
                                name = data.name,
                                user_id = data.user_id,
                            }
                        end
                    end

                    local roster = {}
                    for _, data in pairs(combined) do
                        roster[#roster + 1] = data
                    end

                    table.sort(roster, function(a, b)
                        return string.lower(a.name) < string.lower(b.name)
                    end)

                    return roster
                end

                local function split_player_fields(roster)
                    local fields = {}
                    local current = ""
                    local part = 1

                    local function push_current()
                        if current == "" then return end
                        fields[#fields + 1] = {
                            name = part == 1 and string.format("Players (%d)", #roster) or string.format("Players (%d) - Part %d", #roster, part),
                            value = "```\n" .. current .. "```",
                            inline = false,
                        }
                        current = ""
                        part = part + 1
                    end

                    for _, data in ipairs(roster) do
                        local line = string.format("%s (%s)\n", tostring(data.name), tostring(data.user_id))

                        -- Discord embed field values cap at 1024 chars. Keep headroom for fences.
                        if #current + #line > 940 then
                            push_current()
                        end

                        current = current .. line
                    end

                    push_current()

                    if #fields == 0 then
                        fields[1] = {
                            name = "Players (0)",
                            value = "```\nNo players could be captured\n```",
                            inline = false,
                        }
                    end

                    return fields
                end

                local function report_banned_kick(reason)
                    if banned_kick_reported then return end

                    reason = tostring(reason or "")
                    if reason == "" or not string.find(string.lower(reason), "banned", 1, true) then
                        return
                    end

                    -- Set this before the request so the CoreGui + GuiService fallbacks
                    -- cannot double-send the same disconnect.
                    banned_kick_reported = true
                    refresh_roster_cache()

                    local roster = get_banned_kick_roster()
                    local fields = split_player_fields(roster)

                    table.insert(fields, 1, {
                        name = "Kick Reason",
                        value = "```\n" .. reason:gsub("```", "''' "):sub(1, 950) .. "\n```",
                        inline = false,
                    })

                    fields[#fields + 1] = {
                        name = "Server",
                        value = string.format("Job ID: `%s`\nPlace ID: `%s`", tostring(game.JobId), tostring(game.PlaceId)),
                        inline = false,
                    }

                    if not cheat_client.config.webhook or cheat_client.config.webhook == "" then
                        return
                    end

                    local content = nil
                    if cheat_client.config.webhook_show_username ~= false then
                        content = string.format("||[**%s**]||", plr.Name)
                    end

                    local payload = {
                        -- Discord uses the webhook\'s configured name automatically.
                        content = content,
                        embeds = {{
                            title = "Banned Kick Detected",
                            color = 0xFF3030,
                            fields = fields,
                            footer = {
                                text = string.format("Captured %d player(s)", #roster)
                            }
                        }}
                    }

                    local ok, sent = pcall(function()
                        return send_webhook(cheat_client.config.webhook, payload)
                    end)

                    -- One immediate retry if the request function reports failure.
                    if not ok or sent == false then
                        task.wait(0.15)
                        pcall(function()
                            send_webhook(cheat_client.config.webhook, payload)
                        end)
                    end
                end

                local function inspect_kick_message(message)
                    message = tostring(message or "")
                    if message ~= "" and string.find(string.lower(message), "banned", 1, true) then
                        report_banned_kick(message)
                    end
                end

                -- Catch client-side Player:Kick("...") calls before Roblox disconnects.
                -- Server-side kicks do not necessarily pass through this hook, so the
                -- GuiService/CoreGui watchers below are still required.
                pcall(function()
                    if hookfunction then
                        local old_kick
                        old_kick = hookfunction(plr.Kick, function(self, message, ...)
                            if self == plr then
                                inspect_kick_message(message)
                            end
                            return old_kick(self, message, ...)
                        end)
                    end
                end)

