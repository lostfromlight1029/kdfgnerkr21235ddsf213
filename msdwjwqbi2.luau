                                    if input_value and input_value ~= "" then
                                        local job_ids = {}
                                        for job_id in string.gmatch(input_value, "[^,]+") do
                                            local trimmed = job_id:match("^%s*(.-)%s*$")
                                            if trimmed ~= "" then
                                                job_ids[#job_ids + 1] = trimmed
                                            end
