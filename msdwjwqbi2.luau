            local GELIDUS_MIN_SPEED = 83
            local GELIDUS_MAX_SPEED = 92
            local GELIDUS_DEFAULT_SPEED = 103
            local GELIDUS_REQUIRED_MAXFORCE = Vector3.new(80000, 10, 80000)

            local gelidus_active = {}

            local function add_gelidus_velocity(obj)
                if not obj:IsA("BodyVelocity") then return end
                if obj.Name ~= "ForwardVelocity" then return end
                if obj.MaxForce ~= GELIDUS_REQUIRED_MAXFORCE then return end

                gelidus_active[obj] = true
            end

            local function setup_gelidus_character(character)
                if cheat_client.feature_connections.gelidus_boost_root_child_added then
                    cheat_client.feature_connections.gelidus_boost_root_child_added:Disconnect()
