            }

            cheat_client.trinket_bot = trinket_bot

            local visited_positions = {}
            local collected_trinket_ids = {}
            local COLLECTED_IDS_MAX_SIZE = 500
            local pending_pickup_ids = trinket_bot.pending_pickup_ids
            local active_tween_data = {tween = nil, connection = nil}
            local cr_start_alert_sent = false

            local function mark_trinket_collected(trinket_id_value)
                local count = 0
                for _ in pairs(collected_trinket_ids) do
                    count = count + 1
                    if count > COLLECTED_IDS_MAX_SIZE then
                        collected_trinket_ids = {}
                        break
                    end
                end
                collected_trinket_ids[trinket_id_value] = true
            end

            local PENDING_PICKUP_MAX_SIZE = 100
            local function queue_pending_pickup(trinket_id_value)
                table.insert(pending_pickup_ids, trinket_id_value)
                while #pending_pickup_ids > PENDING_PICKUP_MAX_SIZE do
                    table.remove(pending_pickup_ids, 1)
                end
            end

            local kick_debounce = false
            local kick_after_path = false
            local kick_trinket_name = ""

            local function queue_trinket_kick(trinket_name, detail_message)
                if kick_debounce then
                    return false
                end

                kick_debounce = true
                kick_after_path = true
                kick_trinket_name = trinket_name

                local message = detail_message or string.format("%s found! Going to last point then kicking.", trinket_name)
                local notify_message = message:gsub(" then kicking%.$", "...")
                print(string.format("[Kick on Trinket] %s", message))
                utility:plain_webhook(message)
                library:Notify(notify_message)
                return true
            end

            local function get_phoenix_flower_count()
                local count = 0

                local function count_in(container)
                    if not container then return end
                    for _, obj in ipairs(container:GetChildren()) do
                        if obj:IsA("Tool") and obj.Name:gsub(" ", "") == "PhoenixFlower" then
                            count = count + 1
                        end
                    end
                end

                count_in(FindFirstChild(plr, "Backpack"))
                count_in(plr.Character)
                return count
            end

            local function check_phoenix_flower_kick_threshold()
                -- Khei exclusive even if settings somehow carry over from another world.
                if not is_khei then return false end
                if kick_debounce then return false end
                if not (mem:HasItem("botstarted") and mem:GetItem("botstarted") == "true") then return false end
                if not (Toggles.KickOnPhoenixFlowerAmount and Toggles.KickOnPhoenixFlowerAmount.Value) then return false end

                local threshold = math.clamp(math.floor(tonumber(Options.PhoenixFlowerKickAmount and Options.PhoenixFlowerKickAmount.Value or 1) or 1), 1, 50)
                local count = get_phoenix_flower_count()
                if count < threshold then return false end

                return queue_trinket_kick(
                    "Phoenix Flower",
                    string.format("Phoenix Flower threshold reached (%d/%d)! Going to last point then kicking.", count, threshold)
                )
            end

