    -- Auto Knock (Khei only)
    -- H uses the learned fall-damage RemoteEvent immediately. If the remote has not
    -- been observed yet for this character, H runs a temporary learning drop:
    -- save the current CFrame, noclip the character, move 50 studs straight up, hold
    -- that exact position for 1.3 seconds, then release it into a real gravity-driven
    -- freefall. Noclip stays active until just above the saved position so intervening
    -- geometry is ignored, then collision is restored for a genuine landing event.
    -- Khei fall payload: {severity}, {}
    if is_khei then
        local auto_knock_fall_remote = nil
        local auto_knock_bootstrap_busy = false

        local AUTO_KNOCK_BOOTSTRAP_HEIGHT = 50
        local AUTO_KNOCK_BOOTSTRAP_WAIT = 1.3
        local AUTO_KNOCK_CAPTURE_GRACE = 0.25

        local function auto_knock_notify(message)
            pcall(function()
                if library and library.Notify then
                    library:Notify(message, 3)
                else
                    warn("[Auto Knock] " .. tostring(message))
                end
            end)
        end

        local function auto_knock_get_remotes_folder()
            local character = plr.Character
            if not character then
                return nil
            end

            local handler = FindFirstChild(character, "CharacterHandler")
            if not handler then
                return nil
            end

            return FindFirstChild(handler, "Remotes")
        end

        local function auto_knock_count_keys(tbl, stop_after)
            local count = 0
            for _ in pairs(tbl) do
                count += 1
                if stop_after and count > stop_after then
                    break
                end
            end
            return count
        end

        local function auto_knock_remote_ready()
            local remotes_folder = auto_knock_get_remotes_folder()
            return typeof(auto_knock_fall_remote) == "Instance"
                and auto_knock_fall_remote:IsA("RemoteEvent")
                and remotes_folder
                and auto_knock_fall_remote.Parent == remotes_folder
        end

        -- Passive learner: this is called from the existing FireServer hook before
        -- No Fall / Fall Damage Reducer can swallow or rewrite the natural packet.
        function cheat_client.capture_auto_knock_fall_remote(event, args, remotes_folder)
            if not event or not remotes_folder or event.Parent ~= remotes_folder then
                return false
            end

            if #args ~= 2 or typeof(args[1]) ~= "table" or typeof(args[2]) ~= "table" then
                return false
            end

            local arg1_keys = auto_knock_count_keys(args[1], 2)
            local arg2_keys = auto_knock_count_keys(args[2], 0)
            if arg2_keys ~= 0 then
                return false
            end

            if arg1_keys == 1 and typeof(args[1][1]) == "number" then
                auto_knock_fall_remote = event
                return true
            end

            return false
        end

        local function auto_knock_fire_packet(force_test)
            if not force_test and not cheat_client.config.auto_knock then
                return false
            end

            if not auto_knock_remote_ready() then
                if force_test then
                    auto_knock_notify("Auto Knock: fall remote is not learned yet. Press H once to learn it with the 50-stud real fall.")
                end
                return false
            end

            if type(old_remote) ~= "function" then
                auto_knock_notify("Auto Knock: remote hook is not ready yet.")
                return false
            end

            local severity = math.clamp(tonumber(cheat_client.config.auto_knock_severity) or 50, 1, 270)
            local payload = {severity}

            local ok, err = pcall(function()
                -- Use the original FireServer directly so the intentional Auto Knock
                -- packet is not blocked by No Fall or modified by Fall Damage Reducer.
                old_remote(auto_knock_fall_remote, payload, {})
            end)

            if not ok then
                auto_knock_notify("Auto Knock failed: " .. tostring(err))
                return false
            end

            if force_test then
                auto_knock_notify(string.format("Auto Knock test fired: Khei severity %.1f", severity))
            end

            return true
        end

        -- Only H invokes this bootstrap. It intentionally does not run on load/respawn.
        -- While learning, the character is temporarily noclipped and held exactly
        -- 50 studs above the saved position for 1.3 seconds. It is then released into
        -- a real physics freefall. Temporary noclip ignores geometry until the root is
        -- close to the saved Y, where collision is restored so Rogue sees a true landing.
        local function auto_knock_learn_with_fall_then_fire()
            if auto_knock_bootstrap_busy then
                return
            end

            if not cheat_client.config.auto_knock then
                return
            end

            if auto_knock_remote_ready() then
                auto_knock_fire_packet(false)
                return
            end

            local character = plr.Character
            local root = character and FindFirstChild(character, "HumanoidRootPart")
            local humanoid = character and FindFirstChildOfClass(character, "Humanoid")

            if not character or not root or not humanoid or humanoid.Health <= 0 then
                auto_knock_notify("Auto Knock: character/root is not ready.")
                return
            end

            auto_knock_bootstrap_busy = true

            task.spawn(function()
                local original_cframe = root.CFrame
                local original_linear_velocity = root.AssemblyLinearVelocity
                local original_angular_velocity = root.AssemblyAngularVelocity
                local held_cframe = original_cframe + Vector3.new(0, AUTO_KNOCK_BOOTSTRAP_HEIGHT, 0)

                -- Save each current part's collision state so this temporary noclip
                -- does not overwrite the user's normal character configuration.
                local collision_states = setmetatable({}, {__mode = "k"})
                local hold_connection = nil
                local descendant_connection = nil

                local function noclip_part(part)
                    if not part or not part:IsA("BasePart") then
                        return
                    end

                    if collision_states[part] == nil then
                        collision_states[part] = part.CanCollide
                    end

                    part.CanCollide = false
                end

                local function apply_test_noclip()
                    if not character or not character.Parent then
                        return
                    end

                    for _, object in ipairs(character:GetDescendants()) do
                        if object:IsA("BasePart") then
                            noclip_part(object)
                        end
                    end
                end

                local function stop_hold()
                    if hold_connection then
                        hold_connection:Disconnect()
                        hold_connection = nil
                    end

                    if descendant_connection then
                        descendant_connection:Disconnect()
                        descendant_connection = nil
                    end
                end

                local function restore_collision()
                    for part, can_collide in pairs(collision_states) do
                        if part and part.Parent and part:IsA("BasePart") then
                            pcall(function()
                                part.CanCollide = can_collide
                            end)
                        end
                    end
                    table.clear(collision_states)
                end

                auto_knock_notify("Auto Knock: learning fall remote...")

                local moved = pcall(function()
                    apply_test_noclip()

                    descendant_connection = character.DescendantAdded:Connect(function(object)
                        if object:IsA("BasePart") then
                            noclip_part(object)
                        end
                    end)

                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.CFrame = held_cframe

                    -- Put the humanoid into Freefall while we hold it in place so the
                    -- game's normal landing/fall logic still sees an airborne phase.
                    pcall(function()
                        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
                    end)

                    hold_connection = rs.PreSimulation:Connect(function()
                        if plr.Character ~= character or not root.Parent or humanoid.Health <= 0 then
                            return
                        end

                        apply_test_noclip()
                        root.CFrame = held_cframe
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end)
                end)

                if not moved then
                    stop_hold()
                    restore_collision()
                    auto_knock_bootstrap_busy = false
                    auto_knock_notify("Auto Knock: couldn't start the learning fall.")
                    return
                end

                -- Stay suspended at +50 for the full test duration.
                task.wait(AUTO_KNOCK_BOOTSTRAP_WAIT)
                stop_hold()

                -- Release into an ACTUAL gravity-driven fall rather than teleporting through
                -- fake midpoint positions. This lets Humanoid/CharacterHandler observe a real
                -- Freefall state and a naturally increasing downward AssemblyLinearVelocity.
                local collision_restored_for_landing = false
                local release_time = os.clock()
                local MAX_REAL_FALL_TIME = 1.35
                local RESTORE_COLLISION_HEIGHT = 7

                if plr.Character == character and root.Parent == character then
                    pcall(function()
                        apply_test_noclip()
                        root.CFrame = held_cframe
                        root.AssemblyLinearVelocity = Vector3.new(0, -2, 0)
                        root.AssemblyAngularVelocity = Vector3.zero
                        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
                    end)
                end

                -- Let Roblox gravity do the descent. Keep X/Z centered and noclip through
                -- anything between +50 and the landing zone. At roughly +7 studs we restore
                -- the exact previous collision states so the last part of the fall is a real
                -- physical landing instead of a CFrame snap.
                while plr.Character == character
                    and root.Parent == character
                    and humanoid.Health > 0
                    and (os.clock() - release_time) < MAX_REAL_FALL_TIME
                do
                    local relative_y = root.Position.Y - original_cframe.Position.Y

                    if not collision_restored_for_landing and relative_y <= RESTORE_COLLISION_HEIGHT then
                        restore_collision()
                        collision_restored_for_landing = true
                    elseif not collision_restored_for_landing then
                        apply_test_noclip()
                    end

                    -- Preserve the naturally-generated Y velocity, but kill horizontal drift
                    -- so the character lands at the same X/Z it started from.
                    local velocity = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
                    root.AssemblyAngularVelocity = Vector3.zero

                    -- Stop once normal collision has been restored and Roblox reports ground.
                    if collision_restored_for_landing
                        and humanoid.FloorMaterial ~= Enum.Material.Air
                    then
                        break
                    end

                    rs.Heartbeat:Wait()
                end

                -- Safety restore in case the fall timed out before reaching the landing zone.
                if not collision_restored_for_landing then
                    restore_collision()
                    collision_restored_for_landing = true
                end

                -- Give CharacterHandler several real post-impact frames to emit the fall packet.
                -- Exit early as soon as our FireServer hook captures it.
                local landing_wait_started = os.clock()
                while not auto_knock_remote_ready()
                    and plr.Character == character
                    and root.Parent == character
                    and humanoid.Health > 0
                    and (os.clock() - landing_wait_started) < 0.45
                do
                    rs.Heartbeat:Wait()
                end

                -- Put the player back EXACTLY where H was pressed after the genuine landing
                -- window has completed, and restore their pre-test velocities.
                pcall(function()
                    if plr.Character == character and root.Parent == character then
                        root.CFrame = original_cframe
                        root.AssemblyLinearVelocity = original_linear_velocity
                        root.AssemblyAngularVelocity = original_angular_velocity
                    end
                end)

                task.wait(AUTO_KNOCK_CAPTURE_GRACE)

                if not auto_knock_remote_ready() then
                    auto_knock_bootstrap_busy = false
                    auto_knock_notify("Auto Knock: fall remote was not captured. Press H to try the real learning fall again.")
                    return
                end

                -- The learning drop itself can sometimes be enough to down the
                -- character. Avoid sending a second packet if that already happened.
                if cs:HasTag(character, "Knocked") or cs:HasTag(character, "Unconscious") then
                    auto_knock_bootstrap_busy = false
                    auto_knock_notify("Auto Knock: fall remote learned.")
                    return
                end

                auto_knock_bootstrap_busy = false
                auto_knock_fire_packet(false)
            end)
        end

        function cheat_client.fire_auto_knock(force_test)
            if force_test then
                return auto_knock_fire_packet(true)
            end

            if not cheat_client.config.auto_knock then
                return false
            end

            if auto_knock_remote_ready() then
                return auto_knock_fire_packet(false)
            end

            auto_knock_learn_with_fall_then_fire()
            return true
        end

        -- Fixed H keybind.
        local auto_knock_input_connection = uis.InputBegan:Connect(function(input, game_processed)
            if game_processed or (shared and shared.is_unloading) then
                return
            end

            if uis:GetFocusedTextBox() then
                return
            end

            if input.KeyCode == Enum.KeyCode.H then
                cheat_client.fire_auto_knock(false)
            end
        end)

        local auto_knock_character_connection = plr.CharacterAdded:Connect(function()
            -- CharacterHandler.Remotes is recreated on respawn, so relearn lazily on
            -- the next H press instead of scanning/probing anything automatically.
            auto_knock_fall_remote = nil
            auto_knock_bootstrap_busy = false
        end)

        if shared and shared.connections then
            shared.connections[#shared.connections + 1] = auto_knock_input_connection
            shared.connections[#shared.connections + 1] = auto_knock_character_connection
        end
    end

    -- Blacksmith M2 Serum
    -- The game repeatedly rewrites ForwardVelocity throughout the lunge, so this
    -- intercepts those writes and stretches the complete horizontal velocity curve.
    -- It intentionally keeps the original P and MaxForce unchanged.
    do
        local BLACKSMITH_M2_MULTIPLIER = 1.53
        local BLACKSMITH_M2_MAXFORCE = Vector3.new(80000, 0, 80000)
        local BLACKSMITH_M2_FORCE_TOLERANCE = 2
        local BLACKSMITH_M2_P = 1250
        local BLACKSMITH_M2_P_TOLERANCE = 10

        -- Per-mover state. We only stretch the real lunge phase, then permanently
        -- stop touching that mover once it enters its low-speed tail/end phase.
        local blacksmith_m2_latched = setmetatable({}, {__mode = "k"})
        local BLACKSMITH_M2_MAIN_START_SPEED = 60
        local BLACKSMITH_M2_TAIL_CUTOFF_SPEED = 30

        local function blacksmith_m2_force_matches(value)
            return typeof(value) == "Vector3"
                and math.abs(value.X - BLACKSMITH_M2_MAXFORCE.X) <= BLACKSMITH_M2_FORCE_TOLERANCE
                and math.abs(value.Y - BLACKSMITH_M2_MAXFORCE.Y) <= BLACKSMITH_M2_FORCE_TOLERANCE
                and math.abs(value.Z - BLACKSMITH_M2_MAXFORCE.Z) <= BLACKSMITH_M2_FORCE_TOLERANCE
        end

        local function blacksmith_m2_p_matches(value)
            return type(value) == "number"
                and math.abs(value - BLACKSMITH_M2_P) <= BLACKSMITH_M2_P_TOLERANCE
        end

        local BLACKSMITH_M2_FEEDBACK_BIAS = 0.25
        local BLACKSMITH_M2_MAX_UNSCALE_PASSES = 6

        -- The game's curve can occasionally calculate its next write from the
        -- BodyVelocity value we already boosted. If we blindly multiply that write
        -- again, 1.08x can become 1.08^2, 1.08^3, etc. and cause a huge launch.
        --
        -- Compare the incoming horizontal velocity against the last ORIGINAL/raw
        -- curve value. If removing one or more 1.08x layers makes it closer to that
        -- raw curve, strip those layers first. The final 1.08x is then applied once.
        local function blacksmith_m2_remove_compound_layers(horizontal, state)
            if not state or not state.last_raw_horizontal then
                return horizontal
            end

            local candidate = horizontal
            local last_raw = state.last_raw_horizontal

            for _ = 1, BLACKSMITH_M2_MAX_UNSCALE_PASSES do
                local unscaled = candidate / BLACKSMITH_M2_MULTIPLIER
                local candidate_distance = (candidate - last_raw).Magnitude
                local unscaled_distance = (unscaled - last_raw).Magnitude

                if unscaled_distance + BLACKSMITH_M2_FEEDBACK_BIAS < candidate_distance then
                    candidate = unscaled
                else
                    break
                end
            end

            return candidate
        end

        local function blacksmith_m2_stretch_velocity(value, state)
            if typeof(value) ~= "Vector3" then
                return value
            end

            local incoming_horizontal = Vector3.new(value.X, 0, value.Z)
            if incoming_horizontal.Magnitude <= 0.01 or not state or state.tail_started then
                return value
            end

            -- Normalize away any copies of our own previous 1.08x boost before
            -- doing curve/tail checks. This makes the operation effectively
            -- idempotent: feeding a boosted value back in does not boost it again.
            local horizontal = blacksmith_m2_remove_compound_layers(incoming_horizontal, state)
            local speed = horizontal.Magnitude

            -- Do not touch any small pre-lunge/setup writes. The real Blacksmith
            -- lunge is the high-speed phase (~83 studs/s from our debug).
            if not state.main_seen then
                if speed < BLACKSMITH_M2_MAIN_START_SPEED then
                    return value
                end
                state.main_seen = true
            end

            -- Once the ORIGINAL/raw curve drops into its ~23/~16 studs/s tail,
            -- stop modifying the mover for the rest of its lifetime. This prevents
            -- the rare little shove that could happen right at the end of the lunge.
            if speed < BLACKSMITH_M2_TAIL_CUTOFF_SPEED then
                state.tail_started = true
                return value
            end

            local scaled = horizontal * BLACKSMITH_M2_MULTIPLIER

            -- Save both sides of this write so the next curve update can tell
            -- whether it is raw game velocity or feedback from our boosted value.
            state.last_raw_horizontal = horizontal
            state.last_scaled_horizontal = scaled

            return Vector3.new(scaled.X, value.Y, scaled.Z)
        end

        old_newindex = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
            if not checkcaller()
                and not (shared and shared.is_unloading)
                and cheat_client
                and cheat_client.config
                and cheat_client.config.blacksmith_m2_serum
                and typeof(self) == "Instance"
                and self:IsA("BodyVelocity")
                and self.Name == "ForwardVelocity"
            then
                local future_force = (key == "MaxForce") and value or self.MaxForce
                local future_p = (key == "P") and value or self.P

                -- Latch as soon as this ForwardVelocity has the Blacksmith M2 signature.
                if not blacksmith_m2_latched[self]
                    and blacksmith_m2_force_matches(future_force)
                    and blacksmith_m2_p_matches(future_p)
                then
                    local state = {
                        main_seen = false,
                        tail_started = false,
                    }
                    blacksmith_m2_latched[self] = state

                    if key == "Velocity" and typeof(value) == "Vector3" then
                        value = blacksmith_m2_stretch_velocity(value, state)
                    end

                    local result = old_newindex(self, key, value)

                    -- If Velocity was assigned before MaxForce/P completed the signature,
                    -- inspect the current value once at latch time.
                    if key ~= "Velocity" then
                        local current_velocity = self.Velocity
                        if typeof(current_velocity) == "Vector3" then
                            local stretched = blacksmith_m2_stretch_velocity(current_velocity, state)
                            if stretched ~= current_velocity then
                                old_newindex(self, "Velocity", stretched)
                            end
                        end
                    end

                    return result
                end

                local state = blacksmith_m2_latched[self]

                -- Stretch only the actual lunge portion. Once the low-speed tail
                -- begins, leave every remaining write completely untouched.
                if state
                    and key == "Velocity"
                    and typeof(value) == "Vector3"
                then
                    value = blacksmith_m2_stretch_velocity(value, state)
                end
            end

            return old_newindex(self, key, value)
        end))
    end

    -- Grapple Velocity
    -- GrappleVelocity is normally replicated/parented with its properties already set,
    -- so unlike Blacksmith M2 we do not rely on __newindex seeing the game's writes.
    -- Instead, watch the local character for newly-added BodyVelocity instances and
    -- apply the selected multiplier once when the grapple signature becomes valid.
    do
        local GRAPPLE_VELOCITY_MAXFORCE = Vector3.new(1000000, 1000000, 1000000)
        local GRAPPLE_VELOCITY_FORCE_TOLERANCE = 2
        local GRAPPLE_VELOCITY_MIN_Y = 53
        local GRAPPLE_VELOCITY_INIT_FRAMES = 15

        -- Weak keys make this one-shot per BodyVelocity and prevent accidental
        -- multiplication of our own already-multiplied value.
        local grapple_velocity_applied = setmetatable({}, {__mode = "k"})
        local grapple_velocity_character_connections = setmetatable({}, {__mode = "k"})

        local function grapple_velocity_force_matches(value)
            return typeof(value) == "Vector3"
                and math.abs(value.X - GRAPPLE_VELOCITY_MAXFORCE.X) <= GRAPPLE_VELOCITY_FORCE_TOLERANCE
                and math.abs(value.Y - GRAPPLE_VELOCITY_MAXFORCE.Y) <= GRAPPLE_VELOCITY_FORCE_TOLERANCE
                and math.abs(value.Z - GRAPPLE_VELOCITY_MAXFORCE.Z) <= GRAPPLE_VELOCITY_FORCE_TOLERANCE
        end

        local function grapple_velocity_get_multiplier()
            local multiplier = tonumber(cheat_client.config.grapple_velocity_multiplier) or 1.0
            return math.clamp(multiplier, 1.0, 2.5)
        end

        local function grapple_velocity_try_apply(mover)
            if grapple_velocity_applied[mover]
                or not cheat_client
                or not cheat_client.config
                or not cheat_client.config.grapple_velocity
                or not mover
                or not mover.Parent
                or not mover:IsA("BodyVelocity")
                or mover.Name ~= "GrappleVelocity"
                or not grapple_velocity_force_matches(mover.MaxForce)
            then
                return false
            end

            local raw_velocity = mover.Velocity
            if typeof(raw_velocity) ~= "Vector3" or raw_velocity.Y <= GRAPPLE_VELOCITY_MIN_Y then
                return false
            end

            -- Mark before writing so even if our assignment causes another signal/event,
            -- this exact mover can never be multiplied twice.
            grapple_velocity_applied[mover] = true

            local multiplier = grapple_velocity_get_multiplier()
            if multiplier > 1.0001 then
                mover.Velocity = raw_velocity * multiplier
            end

            return true
        end

        local function grapple_velocity_watch_mover(instance)
            if not instance or not instance:IsA("BodyVelocity") then
                return
            end

            -- DescendantAdded can fire before Name/MaxForce/Velocity finish replicating.
            -- Retry for a few frames so a mover that arrives as a generic BodyVelocity
            -- still gets caught once it becomes GrappleVelocity with the proper values.
            task.spawn(function()
                for _ = 1, GRAPPLE_VELOCITY_INIT_FRAMES do
                    if not instance.Parent or (shared and shared.is_unloading) then
                        return
                    end

                    if grapple_velocity_try_apply(instance) then
                        return
                    end

                    rs.Heartbeat:Wait()
                end
            end)
        end

        local function grapple_velocity_watch_character(character)
            if not character or grapple_velocity_character_connections[character] then
                return
            end

            -- Catch a GrappleVelocity that already exists when this watcher attaches.
            for _, descendant in ipairs(character:GetDescendants()) do
                grapple_velocity_watch_mover(descendant)
            end

            local connection = character.DescendantAdded:Connect(grapple_velocity_watch_mover)
            grapple_velocity_character_connections[character] = connection

            if shared and shared.connections then
                shared.connections[#shared.connections + 1] = connection
            end
        end

        if plr.Character then
            grapple_velocity_watch_character(plr.Character)
        end

        local grapple_character_added = plr.CharacterAdded:Connect(grapple_velocity_watch_character)
        if shared and shared.connections then
            shared.connections[#shared.connections + 1] = grapple_character_added
        end
    end

    -- Shadow Rush Velocity
    -- Only arms when the actual "Shadowrush" tool is used through the character's
    -- LeftClick remote. After that input, matching BodyVelocity instances are accepted
    -- for up to 0.4 seconds. This mirrors the skill-use detection path used by the
    -- Cooldown Visualizer instead of boosting every generic BodyVelocity signature.
    do
        local SHADOW_RUSH_TOOL_NAME = "Shadowrush"
        local SHADOW_RUSH_INPUT_WINDOW = 0.4
        local SHADOW_RUSH_MAXFORCE = Vector3.new(80000, 0, 80000)
        local SHADOW_RUSH_FORCE_TOLERANCE = 2
        local SHADOW_RUSH_ZERO_TOLERANCE = 0.01
        local SHADOW_RUSH_P = 1250
        local SHADOW_RUSH_P_TOLERANCE = 10

        -- One application per mover prevents the multiplier from compounding itself.
        local shadow_rush_velocity_applied = setmetatable({}, {__mode = "k"})
        local shadow_rush_velocity_character_connections = setmetatable({}, {__mode = "k"})
        local shadow_rush_activation_token = 0
        local shadow_rush_active_until = 0

        local function shadow_rush_force_matches(value)
            return typeof(value) == "Vector3"
                and math.abs(value.X - SHADOW_RUSH_MAXFORCE.X) <= SHADOW_RUSH_FORCE_TOLERANCE
                and math.abs(value.Y - SHADOW_RUSH_MAXFORCE.Y) <= SHADOW_RUSH_ZERO_TOLERANCE
                and math.abs(value.Z - SHADOW_RUSH_MAXFORCE.Z) <= SHADOW_RUSH_FORCE_TOLERANCE
        end

        local function shadow_rush_p_matches(value)
            return type(value) == "number"
                and math.abs(value - SHADOW_RUSH_P) <= SHADOW_RUSH_P_TOLERANCE
        end

        local function shadow_rush_velocity_get_multiplier()
            local multiplier = tonumber(cheat_client.config.shadow_rush_velocity_multiplier) or 1.0
            return math.clamp(multiplier, 1.0, 2.5)
        end

        local function shadow_rush_is_armed()
            return os.clock() <= shadow_rush_active_until
        end

        local function shadow_rush_is_equipped()
            local character = plr.Character
            if not character then
                return false
            end

            for _, object in ipairs(character:GetChildren()) do
                if object:IsA("Tool") and object.Name == SHADOW_RUSH_TOOL_NAME then
                    return true
                end
            end

            return false
        end

        local function shadow_rush_velocity_try_apply(mover)
            if not shadow_rush_is_armed()
                or shadow_rush_velocity_applied[mover]
                or not cheat_client
                or not cheat_client.config
                or not cheat_client.config.shadow_rush_velocity
                or not mover
                or not mover.Parent
                or not mover:IsA("BodyVelocity")
                or mover.Name ~= "BodyVelocity"
                or not shadow_rush_force_matches(mover.MaxForce)
                or not shadow_rush_p_matches(mover.P)
            then
                return false
            end

            local raw_velocity = mover.Velocity
            if typeof(raw_velocity) ~= "Vector3"
                or math.abs(raw_velocity.Y) > SHADOW_RUSH_ZERO_TOLERANCE
            then
                return false
            end

            -- Mark before writing so this exact BodyVelocity cannot be multiplied twice.
            shadow_rush_velocity_applied[mover] = true

            local multiplier = shadow_rush_velocity_get_multiplier()
            if multiplier > 1.0001 then
                mover.Velocity = raw_velocity * multiplier
            end

            -- Shadowrush only needs one matching mover for this activation.
            shadow_rush_active_until = 0
            return true
        end

        local function shadow_rush_velocity_watch_mover(instance)
            if not instance or not instance:IsA("BodyVelocity") then
                return
            end

            task.spawn(function()
                -- A BodyVelocity can be parented before MaxForce/P/Velocity are initialized.
                -- Keep checking it only while the current 0.4s Shadowrush window is alive.
                while instance.Parent
                    and not (shared and shared.is_unloading)
                    and shadow_rush_is_armed()
                do
                    if shadow_rush_velocity_try_apply(instance) then
                        return
                    end

                    rs.Heartbeat:Wait()
                end
            end)
        end

        local function shadow_rush_scan_current_movers()
            local character = plr.Character
            if not character then
                return false
            end

            for _, descendant in ipairs(character:GetDescendants()) do
                if descendant:IsA("BodyVelocity")
                    and shadow_rush_velocity_try_apply(descendant)
                then
                    return true
                end
            end

            return false
        end

        local function shadow_rush_arm_from_skill_use(event, remotes_folder)
            if not cheat_client
                or not cheat_client.config
                or not cheat_client.config.shadow_rush_velocity
                or not remotes_folder
                or not event
                or event.Parent ~= remotes_folder
                or event.Name ~= "LeftClick"
                or not shadow_rush_is_equipped()
            then
                return
            end

            shadow_rush_activation_token += 1
            local token = shadow_rush_activation_token
            shadow_rush_active_until = os.clock() + SHADOW_RUSH_INPUT_WINDOW

            -- Scan every frame for the same 0.4s window. This catches the mover whether
            -- it is inserted after LeftClick or was inserted just before the watcher fires.
            task.spawn(function()
                while token == shadow_rush_activation_token
                    and shadow_rush_is_armed()
                    and not (shared and shared.is_unloading)
                do
                    if shadow_rush_scan_current_movers() then
                        return
                    end

                    rs.Heartbeat:Wait()
                end

                if token == shadow_rush_activation_token then
                    shadow_rush_active_until = 0
                end
            end)
        end

        local function shadow_rush_velocity_watch_character(character)
            if not character or shadow_rush_velocity_character_connections[character] then
                return
            end

            local connection = character.DescendantAdded:Connect(shadow_rush_velocity_watch_mover)
            shadow_rush_velocity_character_connections[character] = connection

            if shared and shared.connections then
                shared.connections[#shared.connections + 1] = connection
            end
        end

        -- Public bridge used by the hub's existing FireServer hook. Keeping the input
        -- detection on that one hook avoids stacking another FireServer hook.
        cheat_client.shadow_rush_velocity_handle_remote = shadow_rush_arm_from_skill_use

        if plr.Character then
            shadow_rush_velocity_watch_character(plr.Character)
        end

        local shadow_rush_character_added = plr.CharacterAdded:Connect(function(character)
            shadow_rush_active_until = 0
            shadow_rush_velocity_watch_character(character)
        end)

        if shared and shared.connections then
            shared.connections[#shared.connections + 1] = shadow_rush_character_added
        end
    end

    -- Battle Theme
    -- Pulls the current MP3 list directly from the public GitHub folder. A selected
    -- track is downloaded only when it is needed, cached by Git blob SHA, and then
    -- played as a local custom asset. Danger entering starts a random track. Danger
    -- leaving fades it to zero over 3 seconds. If Danger returns during that fade,
    -- the fade is allowed to finish completely before a fresh random track starts.
    LPH_NO_VIRTUALIZE(function()
        local BATTLE_THEME_API = ""
        local BATTLE_THEME_CACHE = "HYDROXIDE/battle_themes"
        local BATTLE_THEME_FADE_TIME = 3

        local battle_sound = Instance.new("Sound")
        battle_sound.Name = "HydroxideBattleTheme"
        battle_sound.Looped = true
        battle_sound.Volume = 0
        battle_sound.Parent = Services.SoundService

        local battle_random = Random.new()
        local battle_entries = {}
        local battle_entries_loaded = false
        local battle_entries_loading = false
        local battle_last_key = nil
        local battle_fading = false
        local battle_pending_start = false
        local battle_fade_tween = nil
        local battle_fade_serial = 0
        local battle_play_serial = 0
        local battle_last_error = nil

        local function battle_notify(message)
            pcall(function()
                if library and library.Notify then
                    library:Notify(message, 4)
                else
                    warn("[Battle Theme] " .. tostring(message))
                end
            end)
        end

        local function battle_target_volume()
            return math.clamp((tonumber(cheat_client.config.battle_theme_volume) or 50) / 100, 0, 1)
        end

        local function battle_in_danger()
            local character = plr.Character
            return character ~= nil and cs:HasTag(character, "Danger")
        end

        local function battle_asset_function()
            if type(getcustomasset) == "function" then
                return getcustomasset
            end
            if type(getsynasset) == "function" then
                return getsynasset
            end
            if syn then
                if type(syn.getcustomasset) == "function" then
                    return syn.getcustomasset
                end
                if type(syn.getsynasset) == "function" then
                    return syn.getsynasset
                end
            end
            return nil
        end

        local function battle_http_get(url, api_request)
            local requester = http_request or request or (syn and syn.request)

            if requester then
                local headers = {
                    ["User-Agent"] = "Hydroxide-BattleTheme"
                }
                if api_request then
                    headers["Accept"] = "application/vnd.github+json"
                end

                local ok, response = pcall(requester, {
                    Url = url,
                    Method = "GET",
                    Headers = headers
                })

                if ok and type(response) == "table" then
                    local status = tonumber(response.StatusCode or response.statusCode or response.Status or 200) or 200
                    local body = response.Body or response.body
                    if status >= 200 and status < 300 and type(body) == "string" then
                        return body
                    end
                    return nil, "HTTP " .. tostring(status)
                elseif not ok then
                    battle_last_error = tostring(response)
                end
            end

            local ok, body = pcall(function()
                return game:HttpGet(url, true)
            end)
            if ok and type(body) == "string" then
                return body
            end

            return nil, battle_last_error or tostring(body)
        end

        local function battle_ensure_cache_folder()
            if not makefolder or not isfolder then
                return false, "folder functions are not supported"
            end

            local ok, err = pcall(function()
                if not isfolder("HYDROXIDE") then
                    makefolder("HYDROXIDE")
                end
                if not isfolder(BATTLE_THEME_CACHE) then
                    makefolder(BATTLE_THEME_CACHE)
                end
            end)

            if not ok then
                return false, tostring(err)
            end
            return true
        end

        local function battle_refresh_entries(force)
            if battle_entries_loaded and not force then
                return #battle_entries > 0
            end

            if battle_entries_loading then
                repeat
                    task.wait()
                until not battle_entries_loading or (shared and shared.is_unloading)
                return battle_entries_loaded and #battle_entries > 0
            end

            battle_entries_loading = true

            local body, err = battle_http_get(BATTLE_THEME_API, true)
            if not body then
                battle_entries_loading = false
                battle_entries_loaded = false
                battle_last_error = err
                return false, err
            end

            local ok, decoded = pcall(function()
                return Services.HttpService:JSONDecode(body)
            end)

            if not ok or type(decoded) ~= "table" then
                battle_entries_loading = false
                battle_entries_loaded = false
                battle_last_error = ok and "invalid GitHub response" or tostring(decoded)
                return false, battle_last_error
            end

            local found = {}
            for _, item in ipairs(decoded) do
                local name = type(item) == "table" and item.name or nil
                if type(name) == "string"
                    and name:lower():sub(-4) == ".mp3"
                    and item.type == "file"
                    and type(item.download_url) == "string"
                    and item.download_url ~= ""
                then
                    found[#found + 1] = {
                        name = name,
                        sha = tostring(item.sha or ""),
                        download_url = item.download_url
                    }
                end
            end

            table.sort(found, function(a, b)
                return a.name:lower() < b.name:lower()
            end)

            battle_entries = found
            battle_entries_loaded = true
            battle_entries_loading = false
            battle_last_error = nil

            if #battle_entries == 0 then
                return false, "no .mp3 files found in BATTLE_THEMES"
            end

            return true
        end

        local function battle_cache_path(entry)
            local safe_name = entry.name:gsub("[^%w%._%-]", "_")
            local stem = safe_name:gsub("%.mp3$", "")
            local sha = tostring(entry.sha or ""):gsub("[^%w]", ""):sub(1, 12)
            if sha == "" then
                sha = "current"
            end
            return string.format("%s/%s_%s.mp3", BATTLE_THEME_CACHE, stem, sha)
        end

        local function battle_ensure_cached(entry)
            if not writefile or not isfile then
                return nil, "writefile/isfile are not supported"
            end

            local folder_ok, folder_err = battle_ensure_cache_folder()
            if not folder_ok then
                return nil, folder_err
            end

            local path = battle_cache_path(entry)
            local exists_ok, exists = pcall(function()
                return isfile(path)
            end)
            if exists_ok and exists then
                return path
            end

            local body, err = battle_http_get(entry.download_url, false)
            if not body then
                return nil, err
            end

            if #body < 128 then
                return nil, "downloaded file was unexpectedly small"
            end

            local ok, write_err = pcall(function()
                writefile(path, body)
            end)
            if not ok then
                return nil, tostring(write_err)
            end

            return path
        end

        local function battle_make_asset(path)
            local asset_function = battle_asset_function()
            if not asset_function then
                return nil, "getcustomasset/getsynasset is not supported"
            end

            local ok, asset = pcall(asset_function, path)
            if not ok or type(asset) ~= "string" or asset == "" then
                return nil, ok and "custom asset returned an empty id" or tostring(asset)
            end
            return asset
        end

        local function battle_build_candidates()
            local candidates = {}
            for _, entry in ipairs(battle_entries) do
                local key = entry.sha ~= "" and entry.sha or entry.name
                if #battle_entries == 1 or key ~= battle_last_key then
                    candidates[#candidates + 1] = entry
                end
            end

            -- Fisher-Yates shuffle so a failed file can fall through to another random song.
            for i = #candidates, 2, -1 do
                local j = battle_random:NextInteger(1, i)
                candidates[i], candidates[j] = candidates[j], candidates[i]
            end

            return candidates
        end

        local function battle_play_new_theme()
            if not cheat_client.config.battle_theme
                or battle_fading
                or not battle_in_danger()
                or (shared and shared.is_unloading)
            then
                return false
            end

            battle_play_serial += 1
            local serial = battle_play_serial

            local loaded, load_err = battle_refresh_entries(false)
            if not loaded then
                if serial == battle_play_serial and cheat_client.config.battle_theme then
                    battle_notify("Battle Theme: couldn't read GitHub themes (" .. tostring(load_err or "unknown error") .. ")")
                end
                return false
            end

            for _, entry in ipairs(battle_build_candidates()) do
                if serial ~= battle_play_serial
                    or not cheat_client.config.battle_theme
                    or battle_fading
                    or not battle_in_danger()
                    or (shared and shared.is_unloading)
                then
                    return false
                end

                local path, cache_err = battle_ensure_cached(entry)
                if path then
                    local asset, asset_err = battle_make_asset(path)
                    if asset then
                        if serial ~= battle_play_serial
                            or not cheat_client.config.battle_theme
                            or battle_fading
                            or not battle_in_danger()
                        then
                            return false
                        end

                        pcall(function()
                            battle_sound:Stop()
                            battle_sound.SoundId = asset
                            battle_sound.TimePosition = 0
                            battle_sound.Volume = battle_target_volume()
                            battle_sound.Looped = true
                            battle_sound:Play()
                        end)

                        battle_last_key = entry.sha ~= "" and entry.sha or entry.name
                        return true
                    else
                        battle_last_error = asset_err
                    end
                else
                    battle_last_error = cache_err
                end
            end

            if serial == battle_play_serial and cheat_client.config.battle_theme then
                battle_notify("Battle Theme: no playable MP3 (" .. tostring(battle_last_error or "unknown error") .. ")")
            end
            return false
        end

        local function battle_stop_now()
            battle_play_serial += 1
            battle_pending_start = false
            battle_fade_serial += 1
            battle_fading = false

            if battle_fade_tween then
                pcall(function()
                    battle_fade_tween:Cancel()
                end)
                battle_fade_tween = nil
            end

            pcall(function()
                battle_sound:Stop()
                battle_sound.TimePosition = 0
                battle_sound.Volume = 0
            end)
        end

        local function battle_begin_fade()
            battle_play_serial += 1
            battle_pending_start = false

            if battle_fading then
                return
            end

            if not battle_sound.IsPlaying then
                battle_sound.Volume = 0
                return
            end

            battle_fading = true
            battle_fade_serial += 1
            local fade_serial = battle_fade_serial

            if battle_fade_tween then
                pcall(function()
                    battle_fade_tween:Cancel()
                end)
            end

            battle_fade_tween = ts:Create(
                battle_sound,
                TweenInfo.new(BATTLE_THEME_FADE_TIME, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
                {Volume = 0}
            )
            battle_fade_tween:Play()

            task.spawn(function()
                pcall(function()
                    battle_fade_tween.Completed:Wait()
                end)

                if fade_serial ~= battle_fade_serial then
                    return
                end

                pcall(function()
                    battle_sound:Stop()
                    battle_sound.TimePosition = 0
                    battle_sound.Volume = 0
                end)

                battle_fade_tween = nil
                battle_fading = false

                -- Re-entering Danger during the fade deliberately does NOT cancel the
                -- fade. Once it fully ends, start a brand-new random track if still tagged.
                local should_restart = battle_pending_start
                    and cheat_client.config.battle_theme
                    and battle_in_danger()
                    and not (shared and shared.is_unloading)

                battle_pending_start = false

                if should_restart then
                    task.spawn(battle_play_new_theme)
                end
            end)
        end

        local function battle_on_danger_added(instance)
            if instance ~= plr.Character or not cheat_client.config.battle_theme then
                return
            end

            if battle_fading then
                battle_pending_start = true
                return
            end

            if not battle_sound.IsPlaying then
                task.spawn(battle_play_new_theme)
            end
        end

        local function battle_on_danger_removed(instance)
            if instance ~= plr.Character or not cheat_client.config.battle_theme then
                return
            end

            -- If Danger was re-added during a fade and then removed again before the
            -- fade completed, clear the queued restart because combat is no longer active.
            if battle_fading then
                battle_pending_start = false
                return
            end

            battle_begin_fade()
        end

        function cheat_client.set_battle_theme_enabled(value)
            value = value == true
            cheat_client.config.battle_theme = value

            if not value then
                battle_stop_now()
                return
            end

            task.spawn(function()
                local loaded, err = battle_refresh_entries(true)
                if not loaded then
                    if cheat_client.config.battle_theme then
                        battle_notify("Battle Theme: couldn't load GitHub themes (" .. tostring(err or "unknown error") .. ")")
                    end
                    return
                end

                if cheat_client.config.battle_theme and battle_in_danger() and not battle_fading then
                    battle_play_new_theme()
                end
            end)
        end

        function cheat_client.set_battle_theme_volume(value)
            cheat_client.config.battle_theme_volume = math.clamp(tonumber(value) or 50, 0, 100)

            -- During the 3-second fade the tween owns Volume. Changing the slider then
            -- affects the next combat track instead of interrupting the requested fade.
            if not battle_fading and battle_sound.IsPlaying then
                battle_sound.Volume = battle_target_volume()
            end
        end

        function cheat_client.battle_theme_cleanup()
            battle_stop_now()
            pcall(function()
                battle_sound:Destroy()
            end)
        end

        local danger_added_connection = cs:GetInstanceAddedSignal("Danger"):Connect(battle_on_danger_added)
        local danger_removed_connection = cs:GetInstanceRemovedSignal("Danger"):Connect(battle_on_danger_removed)
        local battle_character_added_connection = plr.CharacterAdded:Connect(function(character)
            battle_stop_now()

            -- Normally Danger is added after CharacterAdded. This small deferred check
            -- also catches a character that arrives already tagged before our signal runs.
            task.delay(0.25, function()
                if plr.Character == character
                    and cheat_client.config.battle_theme
                    and cs:HasTag(character, "Danger")
                    and not battle_fading
                then
                    battle_play_new_theme()
                end
            end)
        end)

        if shared and shared.connections then
            shared.connections[#shared.connections + 1] = danger_added_connection
            shared.connections[#shared.connections + 1] = danger_removed_connection
            shared.connections[#shared.connections + 1] = battle_character_added_connection
        end
    end)()

