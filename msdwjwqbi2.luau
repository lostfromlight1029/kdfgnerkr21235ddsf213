        do
            local buff_connections = {}
            local speed_object = nil
            local PRIORITY_SPEED_BOOST_VALUE = -10

            local function has_priority_speed_boost(boosts)
                if not boosts then return false end

                for _, value in ipairs(boosts:GetChildren()) do
                    if value ~= speed_object
                        and value.Name == "SpeedBoost"
                        and (value:IsA("NumberValue") or value:IsA("IntValue"))
                        and value.Value == PRIORITY_SPEED_BOOST_VALUE
                    then
                        return true
                    end
                end

                return false
            end

            local function make_speed_object(character)
                if character and FindFirstChild(character, "Boosts") then
                    local boosts = character.Boosts

                    -- A -10 SpeedBoost always takes priority over the hub's normal SpeedBoost.
                    if has_priority_speed_boost(boosts) then
                        if speed_object and speed_object.Parent then
                            speed_object:Destroy()
                        end
                        speed_object = nil
                        return
                    end

                    if speed_object and speed_object.Parent then
                        speed_object:Destroy()
                    end

                    speed_object = Instance.new("IntValue")
                    speed_object.Name = "SpeedBoost"
                    speed_object.Value = (Toggles.speed_boost and Toggles.speed_boost.Value) and (Options.speed_boost_value and Options.speed_boost_value.Value or 16) or 0
                    speed_object:SetAttribute("MyBuff", true)
                    speed_object.Parent = boosts
                end
            end

            local function setup_buffs(character)
                if buff_connections.character_child_added then
                    buff_connections.character_child_added:Disconnect()
                end
                if buff_connections.boosts_child_added then
                    buff_connections.boosts_child_added:Disconnect()
                end
                if buff_connections.boosts_child_removed then
                    buff_connections.boosts_child_removed:Disconnect()
                end

                if not character then return end

                local boosts = WaitForChild(character, "Boosts")
                if FindFirstChild(character, 'Confused') and Toggles and Toggles.AntiHystericus and Toggles.AntiHystericus.Value then
                    character.Confused:Destroy()
                end

                for _,v in pairs(character:GetChildren()) do
                    if cheat_client.mental_injuries[v.Name] then
                        if Toggles and Toggles.NoInsanity and Toggles.NoInsanity.Value then
                            v:Destroy()
                        end
                    end
                end

                buff_connections.character_child_added = utility:Connection(character.ChildAdded, function(obj)
                    if obj.Name == 'Confused' and Toggles and Toggles.AntiHystericus and Toggles.AntiHystericus.Value then
                        task.defer(obj.Destroy, obj)
                        return
                    end

                    if cheat_client.mental_injuries[obj.Name] and Toggles and Toggles.NoInsanity and Toggles.NoInsanity.Value then
                        task.defer(obj.Destroy, obj)
                        return
                    end

                    if cheat_client.stuns[obj.Name] and Toggles and Toggles.NoStun and Toggles.NoStun.Value then
                        task.defer(obj.Destroy, obj)
                        return
                    end
                end)

                buff_connections.boosts_child_added = utility:Connection(boosts.ChildAdded, function(obj)
                    if obj.Name == "MusicianBuff" and obj.Value ~= "Symphony of Horses" and obj.Value ~= "Song of Lethargy" then
                        task.defer(obj.Destroy, obj)
                        return
                    end

                    if obj.Name == "SpeedBoost" and (obj:IsA("NumberValue") or obj:IsA("IntValue")) then
                        local was_priority = obj.Value == PRIORITY_SPEED_BOOST_VALUE

                        local function apply_priority()
                            if not obj.Parent then return end

                            local is_priority = obj.Value == PRIORITY_SPEED_BOOST_VALUE
                            if is_priority then
                                if speed_object and speed_object.Parent and speed_object ~= obj then
                                    speed_object:Destroy()
                                    speed_object = nil
                                end
                            elseif was_priority and not has_priority_speed_boost(boosts) then
                                task.defer(function()
                                    if character.Parent and Toggles.speed_boost and Toggles.speed_boost.Value then
                                        make_speed_object(character)
                                    end
                                end)
                            end

                            was_priority = is_priority
                        end

                        apply_priority()
                        utility:Connection(obj:GetPropertyChangedSignal("Value"), apply_priority)
                    end

                    if obj.Name == "SpeedBoost"
                        and Toggles and Toggles.NoStun and Toggles.NoStun.Value
                        and not obj:GetAttribute("FootSerumBuff")
                        and not obj:GetAttribute("MyBuff")
                    then
                        task.defer(function()
                            if not obj or not obj.Parent then return end

                            -- Preserve the -10 SpeedBoost even if its Value is assigned
                            -- immediately after the instance is parented into Boosts.
                            if (obj:IsA("NumberValue") or obj:IsA("IntValue")) and obj.Value == PRIORITY_SPEED_BOOST_VALUE then
                                return
                            end

                            obj:Destroy()
                        end)
                        return
                    end
                end)

                buff_connections.boosts_child_removed = utility:Connection(boosts.ChildRemoved, function(obj)
                    if obj.Name == "SpeedBoost"
                        and (obj:IsA("NumberValue") or obj:IsA("IntValue"))
                        and obj.Value == PRIORITY_SPEED_BOOST_VALUE
                    then
                        task.defer(function()
                            if character.Parent
                                and not has_priority_speed_boost(boosts)
                                and Toggles.speed_boost and Toggles.speed_boost.Value
                            then
                                make_speed_object(character)
                            end
                        end)
                    end
                end)

                make_speed_object(character)
            end

            if plr.Character then
                setup_buffs(plr.Character)
            end

            utility:Connection(plr.CharacterAdded, setup_buffs)
            if Toggles.speed_boost then
                Toggles.speed_boost:OnChanged(function()
                    if plr.Character then
                        make_speed_object(plr.Character)
                    end
                end)
            end

            if Options.speed_boost_value then
                Options.speed_boost_value:OnChanged(function()
                    if Toggles.speed_boost and Toggles.speed_boost.Value and speed_object and speed_object.Parent then
                        speed_object.Value = Options.speed_boost_value.Value
                    end
                end)
            end
        end

