        local legit_intent_player_connections = {}
        local legit_intent_global_connections = {}

        local function disconnect_connection(connection)
            if connection and connection.Connected then
                connection:Disconnect()
            end
        end

        local function remove_watched_gui(character)
            local watched = watched_guis[character]
            if not watched then
                return
            end

            if watched.connections then
                for _, connection in pairs(watched.connections) do
                    disconnect_connection(connection)
                end
            end

            if watched.gui and watched.gui.Parent then
                watched.gui:Destroy()
            end

            watched_guis[character] = nil
        end

        local function create_watched_gui(character)
            pcall(function()
                if not character then
                    return
                end

                if not (Toggles and Toggles.LegitIntent and Toggles.LegitIntent.Value) then
                    return
                end

                if character == plr.Character or character.Name == plr.Name then
                    return
                end

                if FindFirstChild(character, "MonsterInfo") then
                    return
                end

                if watched_guis[character] then
                    return
                end

                local root_part = FindFirstChild(character, "HumanoidRootPart")
                if not root_part then
                    root_part = character:WaitForChild("HumanoidRootPart", 10)
                end

                if not root_part then
                    return
                end

                local watched = Instance.new("BillboardGui")
                local display = Instance.new("TextLabel")

                watched.Name = "Watched"
                watched.Adornee = root_part
                -- Use the same protected UI container as the rest of Warya.
                watched.Parent = hidden_folder
                watched.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
                watched.Active = true
                watched.MaxDistance = 400
                watched.Size = UDim2.new(25, 0, 10, 0)
                watched.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)

                display.Name = "Tool"
                display.Parent = watched
                display.BackgroundColor3 = Color3.fromRGB(248, 248, 248)
                display.BackgroundTransparency = 1
                display.BorderSizePixel = 0
                display.Position = UDim2.new(0.25, -5, 0.375, -5)
                display.Size = UDim2.new(0.5, 10, 0.25, 10)
                display.Font = Enum.Font.Antique
                display.Text = ""
                display.TextColor3 = Color3.fromRGB(255, 255, 255)
                display.TextSize = 25
                display.TextStrokeTransparency = 0
                display.TextWrapped = true

                local equipped_tool = FindFirstChildOfClass(character, "Tool")
                if equipped_tool then
                    display.Text = equipped_tool.Name
                end

                local connections = {}

                connections.child_added = utility:Connection(character.ChildAdded, function(object)
                    if object:IsA("Tool") then
                        display.Text = tostring(object.Name)
                    end
                end)

                connections.child_removed = utility:Connection(character.ChildRemoved, function(object)
                    if object:IsA("Tool") then
                        display.Text = ""
                    end
                end)

                connections.ancestry_changed = utility:Connection(character.AncestryChanged, function(_, parent)
                    if parent == nil then
                        remove_watched_gui(character)
                    end
                end)

                watched_guis[character] = {
                    gui = watched,
                    display = display,
                    connections = connections,
                }
            end)
        end

        local function disconnect_player_legit_intent(player)
            local connections = legit_intent_player_connections[player]
            if connections then
                for _, connection in pairs(connections) do
                    disconnect_connection(connection)
                end
                legit_intent_player_connections[player] = nil
            end

            if player and player.Character then
                remove_watched_gui(player.Character)
            end
