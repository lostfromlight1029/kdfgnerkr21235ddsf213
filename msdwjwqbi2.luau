                                    end
                                    disabled_connections = {}

                                    for _, connection in pairs(getconnections(frame.MouseEnter)) do
                                        disabled_connections[#disabled_connections + 1] = connection
                                        connection:Disable()
                                    end
                                end

                                ragoozer_frame = frame
