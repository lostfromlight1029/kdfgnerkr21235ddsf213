do
    -- Directional Mana Run
    -- Port of movement.ahk:
    --   A/D double tap -> W tap, W hold, Up tap
    --   S double tap   -> W tap, W hold, Up tap, Down tap, Down hold
    -- Synthetic held keys are released when the activating direction is released.
    local DOUBLE_TAP_WINDOW = 0.20
    local last_tap = {
        [Enum.KeyCode.A] = 0,
        [Enum.KeyCode.S] = 0,
        [Enum.KeyCode.D] = 0,
    }

    local active_direction = nil
    local synthetic_w_held = false
    local synthetic_down_held = false
    local activation_id = 0

    local function send_key(is_down, key_code)
        pcall(function()
            vim:SendKeyEvent(is_down, key_code, false, game)
        end)
    end

    local function tap_key(key_code)
        send_key(true, key_code)
        task.wait(0.01)
        send_key(false, key_code)
    end

    local function release_directional_mana_run()
        activation_id = activation_id + 1

        if synthetic_down_held then
            send_key(false, Enum.KeyCode.Down)
            synthetic_down_held = false
        end

        if synthetic_w_held then
            send_key(false, Enum.KeyCode.W)
            synthetic_w_held = false
        end

        active_direction = nil
    end

    cheat_client.stop_directional_mana_run = release_directional_mana_run

    local function activate_directional_mana_run(direction)
        release_directional_mana_run()

        activation_id = activation_id + 1
        local my_activation = activation_id
        active_direction = direction

        task.spawn(function()
            -- AHK: Send {w}
            tap_key(Enum.KeyCode.W)
            if my_activation ~= activation_id or active_direction ~= direction then return end

            -- AHK: Sleep 10 / Send {w down}
            task.wait(0.01)
            if my_activation ~= activation_id or active_direction ~= direction then return end
            send_key(true, Enum.KeyCode.W)
            synthetic_w_held = true

            -- AHK: Sleep 10 / Send {up}
            task.wait(0.01)
            if my_activation ~= activation_id or active_direction ~= direction then return end
            tap_key(Enum.KeyCode.Up)

            -- Backwards version also taps Down, then holds Down.
            if direction == Enum.KeyCode.S then
                if my_activation ~= activation_id or active_direction ~= direction then return end
                tap_key(Enum.KeyCode.Down)
                if my_activation ~= activation_id or active_direction ~= direction then return end
                send_key(true, Enum.KeyCode.Down)
                synthetic_down_held = true
            end
        end)
    end

    utility:Connection(uis.InputBegan, function(input, processed)
        if processed then return end
        if uis:GetFocusedTextBox() then return end
        if not (Toggles and Toggles.DirectionalManaRun and Toggles.DirectionalManaRun.Value) then return end

        local key_code = input.KeyCode
        if key_code ~= Enum.KeyCode.A and key_code ~= Enum.KeyCode.S and key_code ~= Enum.KeyCode.D then
            return
        end

        local now = tick()
        local previous = last_tap[key_code] or 0
        last_tap[key_code] = now

        if previous > 0 and (now - previous) <= DOUBLE_TAP_WINDOW then
            last_tap[key_code] = 0
            activate_directional_mana_run(key_code)
        end
    end)

    utility:Connection(uis.InputEnded, function(input)
        if active_direction and input.KeyCode == active_direction then
            release_directional_mana_run()
        end
    end)
end

