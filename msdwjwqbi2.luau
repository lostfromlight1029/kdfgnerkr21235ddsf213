    do
        local BitBuffer
    
        do
            BitBuffer = {}
    
            local NumberToBase64; local Base64ToNumber; do
                NumberToBase64 = {}
                Base64ToNumber = {}
                local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
                for i = 1, #chars do
                    local ch = chars:sub(i, i)
                    NumberToBase64[i-1] = ch
                    Base64ToNumber[ch] = i-1
                end
            end
    
            local PowerOfTwo; do
