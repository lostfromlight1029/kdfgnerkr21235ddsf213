                            while (not settingsShield or not FindFirstChild(settingsShield, "SettingsShield")) and retries < maxRetries do
                                retries = retries + 1
                                task.wait(0.06)
                                settingsShield = FindFirstChild(robloxGui, "SettingsClippingShield")
